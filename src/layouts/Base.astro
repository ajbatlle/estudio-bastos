---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Título de la pestaña. Se le añade el sufijo de marca. */
  title: string;
  /** Meta description. Directa y sin hipérbole, según el tono de marca. */
  description?: string;
  /** Texto del botón de cabecera. */
  accion: string;
  /** Destino del botón de cabecera. */
  accionHref: string;
}

const {
  title,
  description = 'Bastos es un estudio de diseño especializado en organizar y dar forma a información dispersa para convertirla en conocimiento claro, accesible y útil.',
  accion,
  accionHref,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title} — Bastos</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#003ec0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bastos" />
    <meta property="og:title" content={`${title} — Bastos`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />

    {/* Navegación sin recarga: el paso entre páginas se funde en vez de
        parpadear. Astro desactiva la animación solo si el sistema pide
        movimiento reducido. */}
    <ClientRouter />
  </head>

  <!-- El sitio entero va sobre azul de marca: no hay páginas en blanco. -->
  <body class="surface-brand">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header accion={accion} href={accionHref} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .skip {
    position: absolute;
    left: var(--spacing-06);
    top: -100%;
    z-index: 10;
    padding: var(--spacing-04) var(--spacing-06);
    background: var(--white);
    color: var(--color-brand);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .skip:focus {
    top: var(--spacing-06);
  }
</style>
