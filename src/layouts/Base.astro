---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sonido from '../components/Sonido.astro';
import Juego from '../components/Juego.astro';
import Iman from '../components/Iman.astro';

interface Props {
  /** Título de la pestaña. Se le añade el sufijo de marca. */
  title: string;
  /** Usa `title` tal cual en la pestaña, sin añadirle el sufijo. */
  tituloExacto?: boolean;
  /** Meta description. Directa y sin hipérbole, según el tono de marca. */
  description?: string;
  /** Texto del botón de cabecera. */
  accion: string;
  /** Destino del botón de cabecera. */
  accionHref: string;
}

const {
  title,
  tituloExacto = false,
  description = 'Bastos es un estudio de diseño especializado en organizar y dar forma a información dispersa para volverla clara, accesible y útil.',
  accion,
  accionHref,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);

// La portada ya se llama por su nombre completo; el resto de páginas llevan el
// sufijo para que la pestaña diga de quién es el sitio.
const titulo = tituloExacto ? title : `${title} — Estudio Bastos`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#003ec0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Estudio Bastos" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />

    {/* Navegación sin recarga: el paso entre páginas se funde en vez de
        parpadear. Astro desactiva la animación solo si el sistema pide
        movimiento reducido. */}
    <ClientRouter />
  </head>

  <!-- El sitio entero va sobre azul de marca: no hay páginas en blanco. -->
  <body class="surface-brand">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header accion={accion} href={accionHref} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    {/* Las dos marcas que no son perillas de ambiente. Van en el layout y no en
        la página porque el sonido tiene que sobrevivir a la navegación y el
        juego aparta todo lo demás, cabecera aparte. */}
    <Sonido />
    <Juego />

    {/* El imán del puntero sobre los botones. Va en el layout porque los que
        lo llevan —la píldora y el diálogo— están en todas las páginas. */}
    <Iman />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .skip {
    position: absolute;
    left: var(--spacing-06);
    top: -100%;
    z-index: 10;
    padding: var(--spacing-04) var(--spacing-06);
    background: var(--white);
    color: var(--color-brand);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
  }

  .skip:focus {
    top: var(--spacing-06);
  }
</style>
