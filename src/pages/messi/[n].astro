---
// La página de cada gol. Es adonde lleva el QR del afiche impreso, así que se
// piensa primero para el teléfono: el partido y el botón al video arriba, el
// afiche después. Si un video se cae, se cambia en videos.json y el afiche
// colgado sigue sirviendo.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import Leyenda from '../../messi/Leyenda.astro';
import { afiche, equipo, minuto, fecha, estadio } from '../../messi/afiche.js';
import videos from '../../messi/videos.json';

export function getStaticPaths() {
  // Desde la raíz del proyecto y no desde este archivo: en el build, la página
  // se ejecuta desde otra carpeta y una ruta relativa no llegaría.
  const goles = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public/messi/goles.json'), 'utf8'));
  return goles.map((g: any) => ({ params: { n: String(g.n) }, props: { g, total: goles.length } }));
}

const { g, total } = Astro.props as { g: any; total: number };
const base = import.meta.env.BASE_URL;

const partido = `${equipo(g.local)} ${g.marcador[0]}–${g.marcador[1]} ${equipo(g.visita)}`;
const penales = g.penales ? `, ${g.penales[0]}–${g.penales[1]} en penales` : '';
const lugar = estadio(g);

// Mientras no haya un video elegido a mano, una búsqueda armada con el
// partido: nunca se rompe y casi siempre trae el gol entre los primeros.
const elegido = (videos as Record<string, string>)[g.n];
const video = elegido || `https://www.youtube.com/results?search_query=${encodeURIComponent(
  `Messi gol ${equipo(g.local)} ${equipo(g.visita)} ${g.fecha.slice(0, 4)}`)}`;
---

<Base
  title={`${partido}, gol de Messi`}
  description={`Afiche del gol de Lionel Messi en el ${partido} del ${fecha(g)}. Nº ${g.n} de ${total} de la serie de Estudio Bastos.`}
  accion="Todos los goles"
  accionHref={`${base}messi/`}
>
  <article class="container gol">
    <div class="cabeza">
      <h1 class="titulo">{partido}{penales}</h1>
      <p class="bajada">
        Gol de Lionel Messi en el minuto {minuto(g)}. {fecha(g)}{lugar ? `, ${lugar}` : ''}.
      </p>
      <a class="pildora" href={video} target="_blank" rel="noopener" data-iman>Ver el gol</a>
      <p class="nota">
        {elegido ? 'Abre el video en YouTube.' : 'Abre una búsqueda de este partido en YouTube.'}
      </p>
    </div>

    <figure class="afiche" set:html={afiche(g, total, { logo: `${base}messi/statsbomb-negro.png` })} />

    <div class="pie">
      <Leyenda />
      <nav class="serie" aria-label="Otros goles de la serie">
        {g.n > 1 && <a href={`${base}messi/${g.n - 1}/`} rel="prev">Nº {g.n - 1}</a>}
        <span>Nº {g.n} de {total}</span>
        {g.n < total && <a href={`${base}messi/${g.n + 1}/`} rel="next">Nº {g.n + 1}</a>}
      </nav>
    </div>
  </article>
</Base>

<style>
  /* En el teléfono, una columna en el orden en que se busca al escanear: qué
     partido es, el botón al video y después el afiche. En pantalla ancha el
     afiche pasa a la izquierda y el texto lo acompaña. */
  .gol {
    display: grid;
    grid-template-areas: 'cabeza' 'afiche' 'pie';
    gap: var(--spacing-07);
    padding-bottom: var(--layout-lg);
  }

  @media (min-width: 64rem) {
    .gol {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
      grid-template-areas: 'afiche cabeza' 'afiche pie';
      grid-template-rows: auto 1fr;
      column-gap: var(--layout-md);
      align-items: start;
    }
  }

  .cabeza { grid-area: cabeza; }
  .afiche { grid-area: afiche; }
  .pie { grid-area: pie; }

  .bajada {
    margin-top: 0.6rem;
    font-size: var(--text-body-lg);
    max-width: 30em;
  }

  /* El afiche es papel: va plano sobre el mesh, sin marco ni sombra. Alto
     limitado para que en pantalla ancha entre entero sin desplazar. */
  .afiche :global(svg) {
    width: 100%;
    height: auto;
    max-height: 86vh;
    object-fit: contain;
  }

  .nota {
    margin-top: 0.6rem;
    font-size: var(--text-body-sm);
    opacity: 0.75;
  }

  /* La misma píldora de la cabecera: contorno fino que se llena al pasar. */
  .pildora {
    display: inline-flex;
    align-items: center;
    margin-top: var(--spacing-06);
    padding: 0.6em 1.8em;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-pill);
    line-height: 1;
    min-height: 44px;
    transition:
      background var(--transition-normal),
      color var(--transition-normal),
      border-color var(--transition-normal);
  }

  .pildora:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--color-brand);
    opacity: 1;
  }

  .serie {
    display: flex;
    gap: 1.5rem;
    margin-top: var(--spacing-07);
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
  }

  .serie a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .serie span { opacity: 0.75; }
</style>
