---
// La serie entera: los 506 goles con datos, cada uno enlazado a su página.
// Los enlaces y sus nombres salen en el HTML; los afiches se dibujan en el
// navegador cuando se acercan a la pantalla, porque 506 SVG en la página
// pesarían más de diez megas.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import { equipo, minuto, competicion } from '../../messi/afiche.js';

const goles = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public/messi/goles.json'), 'utf8'));
const base = import.meta.env.BASE_URL;
const grupos = Object.entries(Object.groupBy(goles, (g: any) => competicion(g))) as [string, any[]][];
---

<Base
  title="Los goles de Lionel Messi"
  description={`${goles.length} goles de Lionel Messi dibujados con datos abiertos, jugada por jugada, como la pantalla de un juego de mánager. Una serie de afiches de Estudio Bastos.`}
  accion="Ver proyectos"
  accionHref={`${base}proyectos`}
>
  <section class="container intro">
    <h1 class="titulo">Los goles de Lionel Messi</h1>
    <p>
      Dibujamos {goles.length} goles de Messi con los datos abiertos de StatsBomb,
      toque por toque. Cada afiche es la pantalla del partido como la mostraban
      Championship Manager, Football Manager o PC Fútbol: los jugadores son discos
      con su dorsal y la pelota deja su recorrido.
    </p>
    <p class="nota">
      Son los goles que tienen datos: casi todos los de liga con el Barcelona y el
      PSG, los de los Mundiales de 2018 y 2022, la Copa América 2024 y algunas
      finales. Faltan casi toda la Champions, la Copa del Rey y buena parte de los
      de Argentina. Cada afiche lleva un QR a su página, con el video del gol.
    </p>
  </section>

  {/* Sin guion los filtros no harían nada, así que nacen ocultos y el guion
      los muestra. */}
  <nav class="container filtros" aria-label="Filtrar por competición" data-filtros hidden>
    <button type="button" aria-pressed="true" data-grupo="">Todos <span>{goles.length}</span></button>
    {grupos.map(([nombre, lista]) => (
      <button type="button" aria-pressed="false" data-grupo={nombre}>{nombre} <span>{lista.length}</span></button>
    ))}
  </nav>

  <ol class="container grilla" data-messi-grilla={`${base}messi/goles.json`}>
    {goles.map((g: any) => (
      <li data-grupo={competicion(g)}>
        {/* Sin guion se ve el nombre del partido; con guion, el afiche lo
            tapa y el nombre queda para el lector de pantalla. */}
        <a href={`${base}messi/${g.n}/`} data-n={g.n}>
          <span class="rotulo">
            Nº {g.n} · {equipo(g.local)} {g.marcador[0]}–{g.marcador[1]} {equipo(g.visita)}, minuto {minuto(g)}
          </span>
        </a>
      </li>
    ))}
  </ol>
</Base>

<style>
  .intro {
    padding-bottom: var(--spacing-07);
  }

  .intro p {
    margin-top: 0.8rem;
    max-width: 38em;
    font-size: var(--text-body-lg);
  }

  .intro .nota {
    font-size: var(--text-body-sm);
    opacity: 0.8;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: var(--spacing-07);
  }

  .filtros[hidden] { display: none; }

  /* Píldoras de contorno como la de la cabecera; la que está activa se llena.
     La cifra va tabular y apagada: se sabe cuánto hay antes de pulsar. */
  .filtros button {
    position: relative;
    padding: 0.5em 1.2em;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--text-body-sm);
    line-height: 1;
    cursor: var(--cursor);
    transition: background var(--transition-normal), color var(--transition-normal);
  }

  /* Área táctil de 44px sin agrandar la píldora: si creciera, empujaría a las
     de al lado. */
  .filtros button::after {
    content: '';
    position: absolute;
    inset: -8px -2px;
  }

  .filtros button span {
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
    margin-left: 0.25em;
  }

  .filtros button[aria-pressed='true'] {
    background: var(--white);
    color: var(--color-brand);
    border-color: var(--white);
  }

  .grilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    padding-bottom: var(--layout-lg);
  }

  .grilla li[hidden] { display: none; }

  /* El hueco del afiche está reservado con su proporción desde el principio:
     cuando el dibujo llega, no empuja nada. */
  .grilla a {
    position: relative;
    display: block;
    aspect-ratio: 700 / 990;
    background: rgb(242 237 224 / 0.12);
  }

  .grilla a :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rotulo {
    display: block;
    padding: 0.6rem;
    font-size: var(--text-label);
  }

  .grilla a[data-dibujado] .rotulo {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>

<script>
  import { afiche } from '../../messi/afiche.js';

  // Se dibuja cada afiche cuando su hueco se acerca a la pantalla, y una sola
  // vez: dibujarlos todos al cargar serían unos cuarenta mil nodos de golpe.
  let observador: IntersectionObserver | null = null;
  // En la primera visita pueden llegar dos montajes casi juntos (el directo y
  // el de `astro:page-load`); el que llega tarde de la descarga se descarta.
  let vuelta = 0;

  async function montar() {
    const grilla = document.querySelector<HTMLElement>('[data-messi-grilla]');
    if (!grilla) return;
    const esta = ++vuelta;
    const goles = await fetch(grilla.dataset.messiGrilla!).then(r => r.json());
    if (esta !== vuelta) return;
    const logo = grilla.dataset.messiGrilla!.replace('goles.json', 'statsbomb-negro.png');

    observador = new IntersectionObserver(entradas => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const a = e.target as HTMLElement;
        observador!.unobserve(a);
        if ('dibujado' in a.dataset) continue;
        // Dentro del enlace el afiche se calla: el nombre del partido ya lo
        // dice el rótulo, y el lector de pantalla lo leería dos veces.
        a.insertAdjacentHTML('beforeend', afiche(goles[Number(a.dataset.n) - 1], goles.length, { logo })
          .replace(/role="img" aria-label="[^"]*"/, 'aria-hidden="true"'));
        a.dataset.dibujado = '';
      }
    }, { rootMargin: '800px 0px' });
    grilla.querySelectorAll('a[data-n]').forEach(a => observador!.observe(a));

    // Un filtro activo cada vez. Se ocultan los que no corresponden en vez de
    // rehacer la lista: los afiches ya dibujados no se vuelven a dibujar.
    const filtros = document.querySelector<HTMLElement>('[data-filtros]');
    if (!filtros) return;
    filtros.hidden = false;
    filtros.addEventListener('click', ev => {
      const boton = (ev.target as HTMLElement).closest('button');
      if (!boton) return;
      for (const b of filtros.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === boton));
      const grupo = boton.dataset.grupo;
      grilla.querySelectorAll<HTMLElement>('li').forEach(li => { li.hidden = !!grupo && li.dataset.grupo !== grupo; });
    });
  }

  function limpiar() {
    observador?.disconnect();
    observador = null;
  }

  if (!(window as any).__messiMontado) {
    (window as any).__messiMontado = true;
    // La primera pasada va aquí y no solo en `astro:page-load`: el guion se
    // ejecuta como módulo y puede llegar después de que ese aviso ya sonó.
    montar();
    document.addEventListener('astro:page-load', () => { limpiar(); montar(); });
    document.addEventListener('astro:before-swap', limpiar);
  }
</script>
