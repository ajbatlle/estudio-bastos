---
import Base from '../layouts/Base.astro';
import MarcaInline from '../components/MarcaInline.astro';
import EquipoInline from '../components/EquipoInline.astro';
import MarcasInline from '../components/MarcasInline.astro';
import ProyectosInline from '../components/ProyectosInline.astro';
import MetodologiaInline from '../components/MetodologiaInline.astro';
import DispersaInline from '../components/DispersaInline.astro';
import AgendaDialogo from '../components/AgendaDialogo.astro';
---

<Base
  title="Estudio Bastos"
  tituloExacto
  accion="Ver proyectos"
  accionHref={`${import.meta.env.BASE_URL}proyectos`}
>
  <section class="container manifiesto">
    {/* Las marcas se alternan: abren el primer y el tercer párrafo, cierran el
        segundo y el cuarto. El orden del set se mantiene. */}
    {/* Cada párrafo es un <span> en bloque y no un <br>: así puede llevar su
        propia separación, distinta del interlineado. Un <p> aquí dentro sería
        HTML inválido, porque un <h1> solo admite contenido de frase. */}
    {/* El punto final va siempre dentro de la frase que cierra —fusión,
        subrayado y todo—: fuera queda como un resto suelto de otro color. */}
    <h1>
      <span class="parrafo">
        <MarcaInline forma="rombos" etiqueta="sonido" posicion="abre" control="sonido" />
        Bastos es un <EquipoInline>estudio de diseño</EquipoInline> especializado en <strong
          >organizar y dar forma a</strong
        > <DispersaInline>información dispersa</DispersaInline> para volverla <strong
          class="fusion">clara, accesible y útil.</strong
        >
      </span>

      <span class="parrafo">
        Trabajamos con la <strong>identidad</strong> de <MarcasInline
          >marcas y organizaciones</MarcasInline
        >, y desarrollamos
        <ProyectosInline
          >publicaciones editoriales, plataformas digitales y otros productos de comunicación.</ProyectosInline
        >
        <MarcaInline forma="asterisco" etiqueta="luz" posicion="cierra" control="luz" />
      </span>

      <span class="parrafo">
        <MarcaInline forma="circulos" etiqueta="textura" posicion="abre" control="textura" />
        Cada proyecto toma un mínimo de <MetodologiaInline>4 semanas.</MetodologiaInline>
      </span>

      <span class="parrafo">
        <button class="cta" type="button" data-agenda-abrir
          ><strong>Escríbenos y agendamos una conversación.</strong></button
        >
        <MarcaInline forma="flor" etiqueta="juego" posicion="cierra" control="juego" />
      </span>
    </h1>
  </section>

  {/* Fuera del <h1>: un <dialog> ahí dentro sería HTML inválido. */}
  <AgendaDialogo />
</Base>

<style>
  .manifiesto {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--spacing-05) var(--spacing-11);
  }

  /* Un solo bloque de texto continuo. Los saltos de línea son deliberados:
     cada uno cierra una idea, siempre después de un elemento de marca. */
  h1 {
    font-size: clamp(1.125rem, 1.8vw, 2.125rem);
    font-weight: var(--weight-regular);
    line-height: 1.48;
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
  }

  h1 strong {
    font-weight: var(--weight-bold);
  }

  /* El mismo recurso que las marcas: blanco en `difference` sobre el mesh del
     fondo. No lleva color pintado —lo produce lo que tiene debajo—, así que
     vira a lo largo de la línea y cambia con la perilla de luz. */
  h1 .fusion {
    mix-blend-mode: difference;
  }

  /* Separación entre párrafos, aparte del interlineado: el salto de idea se
     lee, pero sin abrir tanto como una línea entera en blanco. */
  .parrafo {
    display: block;
  }

  .parrafo + .parrafo {
    margin-top: 0.5em;
  }

  /* El subrayado es el estado en reposo; al pasar el puntero se aclara y se
     separa del texto. Se animan las propias propiedades del subrayado en vez
     de la opacidad del enlace, para que la palabra no se apague. */
  .cta {
    all: unset;
    cursor: var(--cursor);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: rgb(255 255 255 / 0.9);
    text-underline-offset: 0.22em;
    transition:
      text-decoration-color var(--transition-normal),
      text-underline-offset var(--transition-normal);
  }

  .cta:hover {
    opacity: 1;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 0.34em;
  }

  @media (max-width: 48rem) {
    .manifiesto {
      align-items: flex-start;
      padding-block: var(--spacing-07) var(--spacing-10);
    }

    h1 {
      line-height: 1.4;
    }

    /* La separación entre párrafos se recorta en pantallas estrechas: ahí el
       texto ya ocupa más líneas y el aire sobra. */
    .parrafo + .parrafo {
      margin-top: 0.35em;
    }
  }
</style>
