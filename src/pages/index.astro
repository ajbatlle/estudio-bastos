---
import Base from '../layouts/Base.astro';
import MarcaInline from '../components/MarcaInline.astro';

// ⚠ PENDIENTE: dirección de contacto real del estudio.
const CORREO = 'hola@estudiobastos.cl';
---

<Base
  title="Diseño y Comunicaciones"
  accion="Ver proyectos"
  accionHref={`${import.meta.env.BASE_URL}proyectos`}
>
  <section class="container manifiesto">
    <h1>
      Bastos es un <strong>estudio de diseño</strong>
      <MarcaInline forma="rombos" /> especializado en <strong
        >organizar y dar forma a información dispersa</strong
      > para convertirla en conocimiento claro, accesible y útil.
      <MarcaInline forma="flor" /><br />

      Trabajamos con la <strong>identidad</strong> de marcas y organizaciones, y desarrollamos
      <strong>publicaciones editoriales, plataformas digitales y otros productos de comunicación.</strong>
      <MarcaInline forma="flor" /><br />

      Cada proyecto toma un mínimo de 6 semanas.<br />

      <MarcaInline forma="rombos" /><a class="cta" href={`mailto:${CORREO}`}
        ><strong>Escríbenos y agendamos una conversación.</strong></a
      >
    </h1>
  </section>
</Base>

<style>
  .manifiesto {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--spacing-09) var(--spacing-12);
  }

  /* Un solo bloque de texto continuo. Los saltos de línea son deliberados:
     cada uno cierra una idea, siempre después de un elemento de marca. */
  h1 {
    font-size: clamp(1.5rem, 2.45vw, 2.875rem);
    font-weight: var(--weight-regular);
    line-height: 1.48;
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
  }

  h1 strong {
    font-weight: var(--weight-bold);
  }

  .cta {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  @media (max-width: 48rem) {
    .manifiesto {
      align-items: flex-start;
      padding-block: var(--spacing-07) var(--spacing-10);
    }

    h1 {
      line-height: 1.4;
    }

    /* En pantallas estrechas los saltos forzados rompen la lectura:
       el texto fluye y las marcas quedan como separadores. */
    h1 br {
      display: none;
    }
  }
</style>
