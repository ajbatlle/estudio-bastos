---
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { getCollection } from 'astro:content';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';
import { idioma, ruta as rutaSitio } from '../i18n';

const lang = idioma(Astro.url);
const en = lang === 'en';

const base = import.meta.env.BASE_URL;

// En inglés, lo que el .md traduce pisa al español; lo que no, se queda.
const proyectos = (await getCollection('proyectos'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((p) => ({ ...p, data: { ...p.data, ...(en ? p.data.en : {}) } }));

// Las láminas de cada serie se buscan en el disco: un documento puede tener
// cien páginas y enumerarlas en el .md no lo leería nadie. Solo cuentan las
// numeradas con tres cifras, que son las que escribe el pipeline; así, si queda
// un archivo viejo de otra numeración, no se cuela en el pase.
const laminasDeLaSerie = (prefijo: string) =>
  readdirSync('public/media')
    .filter((archivo) => new RegExp(`^${prefijo}-\\d{3}\\.webp$`).test(archivo))
    .sort();

// Cada lámina lleva su propia proporción, leída del archivo en el build. Es lo
// que permite que dentro de un mismo pase una página horizontal se vea grande y
// una vertical se vea alta: si el marco lo fijara la primera, todas las demás
// tendrían que encogerse hasta caber en el hueco de aquella.
const piezas = new Map<string, { archivo: string; proporcion: number }[]>();

const esVideo = (archivo: string) => /\.(mp4|webm)$/.test(archivo);

// Un video que se rehace conserva su nombre, y el navegador seguiría sirviendo
// el de la caché. La fecha del archivo en la dirección obliga a pedirlo de nuevo.
const version = (archivo: string) =>
  Math.round(statSync(`public/media/${archivo}`).mtimeMs).toString(36);

// sharp no lee video, así que la proporción se saca de la cabecera del MP4: la
// caja `tkhd` guarda el ancho y el alto de la pista en sus últimos ocho bytes,
// en coma fija 16.16. Basta para no tener que escribirla a mano en el .md.
const proporcionDelVideo = (archivo: string) => {
  const datos = readFileSync(`public/media/${archivo}`);
  let inicio = datos.indexOf('tkhd');
  while (inicio > 0) {
    const fin = inicio - 4 + datos.readUInt32BE(inicio - 4);
    const ancho = datos.readUInt32BE(fin - 8) / 65536;
    const alto = datos.readUInt32BE(fin - 4) / 65536;
    if (ancho && alto) return ancho / alto;
    inicio = datos.indexOf('tkhd', inicio + 4);
  }
  return 16 / 9;
};

for (const proyecto of proyectos) {
  const { media, serie } = proyecto.data;
  const archivos = serie
    ? laminasDeLaSerie(serie)
    : media
      ? Array.isArray(media)
        ? media
        : [media]
      : [];

  const medidas = await Promise.all(
    archivos.map(async (archivo) => {
      if (esVideo(archivo)) return { archivo, proporcion: proporcionDelVideo(archivo) };
      const { width, height } = await sharp(`public/media/${archivo}`).metadata();
      return { archivo, proporcion: width && height ? width / height : 1.6 };
    }),
  );

  if (medidas.length) piezas.set(proyecto.id, medidas);
}

// Los logos se igualan por peso, no por ancho: todos ocupan la misma superficie.
// A igual ancho, uno casi cuadrado como el de Mano y Aguja se veía diminuto al
// lado del de Tisvol, que mide ocho veces más de ancho que de alto. El alto
// tiene un tope —la pestaña no crece hacia abajo, que de ella cuelga la ficha—
// y la pestaña toma el ancho de su logo más un margen a cada lado.
const SUPERFICIE = 2300, ALTO_MAXIMO = 42, MARGEN = 22;
const logos = new Map<string, { ancho: number; alto: number; pestana: number }>();

for (const proyecto of proyectos) {
  if (!proyecto.data.logo) continue;
  const { width, height } = await sharp(`public/media/logos/${proyecto.data.logo}.webp`).metadata();
  const proporcion = width && height ? width / height : 3;
  const alto = Math.min(ALTO_MAXIMO, Math.sqrt(SUPERFICIE / proporcion));
  const ancho = alto * proporcion;
  logos.set(proyecto.id, {
    ancho: Math.round(ancho),
    alto: Math.round(alto),
    pestana: Math.round(ancho + MARGEN * 2),
  });
}

type Lamina = { archivo: string; proporcion: number; numero: number };
type Hoja = { laminas: Lamina[]; proporcion: number; ajuste: 'cubre' | 'contiene' };

// Una página suelta mide menos de 1,15 de ancho por alto; una doble página, más.
const SUELTA = 1.15;

// Las hojas son lo que se ve de una vez en el recuadro. Una publicación se mira
// abierta, así que las páginas sueltas se casan de dos en dos —salvo la
// portada, que va sola como en el libro—. Una identidad se enseña en grilla de
// cuatro. Una herramienta es una sola grabación.
const hojasDe = (pieza: string, laminas: Lamina[]): Hoja[] => {
  const juntar = (grupo: Lamina[]): Hoja => {
    const proporcion = grupo.reduce((suma, l) => suma + l.proporcion, 0);
    return {
      laminas: grupo,
      proporcion,
      // A sangre solo lo que ya es apaisado: una portada vertical recortada a
      // 16/10 perdería más de la mitad, así que esa se queda entera.
      // Un video que no es una grabación de pantalla es una pieza ya montada
      // —fotos del impreso— y también va a sangre.
      ajuste:
        (pieza === 'catalogo' && proporcion >= SUELTA) ||
        (pieza !== 'herramienta' && grupo.some((l) => esVideo(l.archivo)))
          ? 'cubre'
          : 'contiene',
    };
  };

  if (pieza === 'identidad') {
    const hojas: Hoja[] = [];
    for (let i = 0; i < laminas.length; i += 4) {
      hojas.push({ ...juntar(laminas.slice(i, i + 4)), ajuste: 'cubre' });
    }
    return hojas;
  }

  if (pieza === 'herramienta') return laminas.map((l) => juntar([l]));

  const hojas: Hoja[] = [];
  let pendiente: Lamina | null = null;
  for (const [i, lamina] of laminas.entries()) {
    const suelta = lamina.proporcion < SUELTA;
    // La contraportada también va sola, si no le queda pareja.
    if (!suelta || i === 0 || (i === laminas.length - 1 && !pendiente)) {
      if (pendiente) hojas.push(juntar([pendiente]));
      pendiente = null;
      hojas.push(juntar([lamina]));
    } else if (pendiente) {
      hojas.push(juntar([pendiente, lamina]));
      pendiente = null;
    } else {
      pendiente = lamina;
    }
  }
  if (pendiente) hojas.push(juntar([pendiente]));
  return hojas;
};

// Folio con dos cifras: «03 / 24».
const folio = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={en ? 'Projects' : 'Proyectos'}
  description={en
    ? 'Studio projects: identity, editorial publications, digital platforms and other communication products.'
    : 'Proyectos del estudio: identidad, publicaciones editoriales, plataformas digitales y otros productos de comunicación.'}
  accion={en ? 'Back to home' : 'Volver al inicio'}
  accionHref={rutaSitio(lang)}
>
  <h1 class="visually-hidden">{en ? 'Projects' : 'Proyectos'}</h1>

  {/* Una lista, no una baraja: los proyectos van uno bajo otro y la página se
      desplaza con la rueda del navegador, sin nada que la sustituya. Cada
      proyecto lleva su ficha a la izquierda, que se queda fija mientras su pieza
      pasa por la derecha, y la píldora de abajo dice cuál se está leyendo. El
      estado de cada uno lo pone el guion en `data-estado`. */}
  <div class="escenario" data-lista>
    {
      proyectos.map((proyecto, indice) => {
        const { titulo, descripcion, tipo, rol, anio, enlace, enlaceTexto, mediaAlt, pieza } =
          proyecto.data;

        const hojas = hojasDe(
          pieza,
          (piezas.get(proyecto.id) ?? []).map((l, numero) => ({ ...l, numero })),
        );
        const logo = logos.get(proyecto.id);

        return (
          <article
            class="proyecto container"
            data-proyecto
            data-estado={indice === 0 ? 'activo' : 'fuera'}
            aria-label={`${indice + 1} ${en ? 'of' : 'de'} ${proyectos.length}: ${titulo}`}
          >
            <div class="ficha">
              {/* El logo del cliente, en su pestaña blanca: los logos están
                  hechos para fondo claro y sobre el azul varios se desvanecen. */}
              {logo && (
                <span class="pestana" style={`--pestana-ancho: ${logo.pestana}px`} aria-hidden="true">
                  <img
                    src={`${base}media/logos/${proyecto.data.logo}.webp`}
                    alt=""
                    width={logo.ancho}
                    height={logo.alto}
                    loading={indice < 3 ? 'eager' : 'lazy'}
                  />
                </span>
              )}

              <h2>{titulo}</h2>
              {descripcion && <p class="descripcion">{descripcion}</p>}

              <dl class="meta">
                <dt class="visually-hidden">{en ? 'Type' : 'Tipo'}</dt>
                <dd>{tipo}</dd>
                {/* Si el rol dice lo mismo que el tipo, o no está, la línea sobra. */}
                {rol && rol !== tipo && (
                  <>
                    <dt class="visually-hidden">{en ? 'Role' : 'Rol'}</dt>
                    <dd>{rol}</dd>
                  </>
                )}
                <dt class="visually-hidden">{en ? 'Year' : 'Año'}</dt>
                <dd>{anio}</dd>
              </dl>

              {/* La pieza se amplía pulsándola, pero con teclado no hay dónde
                  pulsar. Este botón es esa puerta, y solo aparece al tabular. */}
              <button type="button" class="visually-hidden" data-ampliar>
                {en ? 'View the piece enlarged' : 'Ver la pieza ampliada'}
              </button>

              {enlace && (
                <a
                  class="enlace"
                  href={enlace.startsWith('/') ? rutaSitio(lang, enlace.slice(1)) : enlace}
                  target={enlace.startsWith('/') ? undefined : '_blank'}
                  rel={enlace.startsWith('/') ? undefined : 'noopener'}
                >
                  {enlaceTexto ?? enlace}
                  <svg
                    class="flecha"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.5 11.5 11.5 4.5" />
                    <path d="M5.5 4.5h6v6" />
                  </svg>
                  {!enlace.startsWith('/') && (
                    <span class="visually-hidden">{en ? '(opens in a new tab)' : '(se abre en una pestaña nueva)'}</span>
                  )}
                </a>
              )}
            </div>

            {/* El recuadro mide lo mismo en todos los proyectos; lo que cambia
                es cómo se enseña la pieza dentro, según `data-pieza`. Las hojas
                se pasan de una en una, con fundido: una doble página se mira
                abierta y quieta, no cayendo. */}
            <div
              class="media"
              data-pieza={pieza}
              data-sangre={hojas.some((h) => h.ajuste === 'cubre') ? '' : undefined}
            >
              {hojas.length > 0 && (
                <span class="pantalla">
                  {hojas.map((hoja, turno) => (
                    <span
                      class="hoja"
                      data-hoja
                      data-vista={turno === 0 ? '' : undefined}
                      data-ajuste={hoja.ajuste}
                      style={`--proporcion: ${hoja.proporcion.toFixed(4)}`}
                    >
                      <span class="pliego">
                        {pieza === 'herramienta' && (
                          <span class="barra" aria-hidden="true">
                            <i />
                            <i />
                            <i />
                          </span>
                        )}
                        {/* Solo la primera hoja trae `src`: es la que se ve al
                            llegar. Las demás esperan en `data-src` y se piden
                            cuando les toca. Sin esto se descargarían las 283
                            de golpe. */}
                        {hoja.laminas.map(({ archivo, proporcion, numero }) =>
                          esVideo(archivo) ? (
                            // Un video real y no un WebP animado: a igual
                            // nitidez pesa varias veces menos. Lo arranca y lo
                            // para el guion según el proyecto esté a la vista.
                            <video
                              src={turno === 0 ? `${base}media/${archivo}?v=${version(archivo)}` : undefined}
                              data-src={turno === 0 ? undefined : `${base}media/${archivo}?v=${version(archivo)}`}
                              style={`--proporcion: ${proporcion.toFixed(4)}`}
                              aria-label={mediaAlt}
                              muted
                              loop
                              playsinline
                              preload={indice === 0 ? 'auto' : 'none'}
                            />
                          ) : (
                          <img
                            src={turno === 0 ? `${base}media/${archivo}` : undefined}
                            data-src={turno === 0 ? undefined : `${base}media/${archivo}`}
                            alt={numero === 0 ? (mediaAlt ?? '') : ''}
                            style={`--proporcion: ${proporcion.toFixed(4)}`}
                            data-lamina={numero}
                            loading={indice < 3 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                          ),
                        )}
                      </span>
                    </span>
                  ))}
                </span>
              )}
            </div>

            {/* El folio va bajo el recuadro, a la derecha: dice en qué hoja vas. */}
            {hojas.length > 1 && (
              <p class="folio" aria-hidden="true">
                <span data-folio>01</span> / {folio(hojas.length)}
              </p>
            )}
          </article>
        );
      })
    }
  </div>

  {/* La píldora: dice qué proyecto se está leyendo y cuántos hay. Va fija abajo,
      al centro, y no se pulsa; es un rótulo, como el de la grabación en la
      página de Reboot que la inspira. */}
  <div class="indicador" data-indicador aria-hidden="true">
    <span class="indicador-titulo" data-indicador-titulo>{proyectos[0]?.data.titulo}</span>
    <span class="cuenta"><span data-indicador-n>01</span> / {folio(proyectos.length)}</span>
  </div>

  {/* El visor. Va fuera de la lista porque no es un proyecto más:
      se pone delante de todo. Es un <dialog>, así que el navegador ya trae el
      cierre con Esc, el foco atrapado dentro y el resto de la página inerte. */}
  <dialog class="visor" data-visor aria-label={en ? 'Enlarged piece' : 'Pieza ampliada'}>
    <button type="button" class="cerrar" data-visor-cerrar aria-label={en ? 'Close' : 'Cerrar'}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <img data-visor-img alt="" />

    <p class="paginas">
      <span data-visor-indice>1</span> / <span data-visor-total>1</span>
    </p>
  </dialog>
</Base>

<style>
  /* ——— La lista ———
     La página se desplaza como cualquier otra: la rueda del navegador, sin
     inercia añadida ni gesto capturado. Lo que hace que se sienta bien es lo
     que pasa mientras uno baja: la ficha de cada proyecto se queda fija a la
     izquierda mientras su pieza recorre la pantalla, y las grabaciones corren
     solas mientras se ven. */
  .escenario {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-bottom: clamp(6rem, 18vh, 10rem);
  }

  .proyecto {
    --aire: clamp(3.5rem, 16vh, 8rem);
    display: grid;
    /* Proporción tomada de los mockups: ~27% / ~66%, con un canal entre medio. */
    grid-template-columns: minmax(0, 27fr) minmax(0, 66fr);
    /* La segunda fila es solo aire: el espacio entre una pieza y la siguiente.
       Va dentro del proyecto y no fuera como margen porque la ficha ocupa las
       dos filas, y es esa altura la que le da recorrido para quedarse fija
       mientras su pieza pasa y hasta que la siguiente ya está a media pantalla. */
    grid-template-rows: auto var(--aire);
    column-gap: 7%;
    align-items: start;
    padding-top: var(--aire);
  }

  /* El primero arranca casi pegado a la cabecera: el aire de arriba ya lo
     pone ella, y sumarle el de entre proyectos dejaba media pantalla vacía. */
  .proyecto:first-child {
    padding-top: clamp(1rem, 4vh, 2.5rem);
  }

  .proyecto .ficha {
    grid-row: 1 / 3;
  }

  .proyecto .media {
    grid-column: 2;
    grid-row: 1;
  }

  /* La ficha queda anclada arriba mientras su pieza recorre la pantalla. Al
     cruzar la línea de lectura el siguiente proyecto, la ficha anterior se
     apaga y entra la nueva, en el mismo sitio: la columna de la izquierda
     cambia de texto sin moverse, que es lo que se siente al bajar. */
  .ficha {
    position: sticky;
    top: clamp(5rem, 22vh, 9rem);
    transition: opacity 0.45s var(--ease);
  }

  .proyecto[data-estado='fuera'] .ficha {
    opacity: 0;
    pointer-events: none;
  }

  /* ——— La pestaña del cliente ———
     Un recuadro blanco con el logo, encima del título. El alto es fijo y el
     ancho lo toma cada logo, calculado en el build. */
  .pestana {
    display: grid;
    place-items: center;
    width: var(--pestana-ancho, 150px);
    height: 56px;
    margin-bottom: 1.25rem;
    background: var(--white);
    border-radius: 8px;
  }

  .pestana img {
    display: block;
    object-fit: contain;
  }

  h2 {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .descripcion {
    margin-top: 1em;
  }

  .meta {
    margin-top: 1em;
  }

  .descripcion,
  .meta {
    font-size: var(--text-body-sm);
    line-height: 1.55;
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1em;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    line-height: 1.65;
  }

  .flecha {
    width: 0.9em;
    height: 0.9em;
    flex: none;
  }

  /* Plano: ni bisel hundido ni sombras bajo las láminas. El recuadro es un
     papel gris claro y la pieza se apoya en él sin levantarse. */
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    /* El recuadro se declara contenedor de consulta para que cada hoja pueda
       medirse contra él —`cqw` y `cqh` son su caja interior, ya descontado el
       paspartú— y calcular por sí misma cuánto tiene que encoger. */
    container-type: size;
    background: var(--surface-subtle);
    border-radius: 8px;
    /* La pieza no toca el borde: el recuadro actúa de paspartú. En porcentaje
       para que el aire crezca con él. */
    padding: clamp(10px, 4%, 40px);
  }

  /* A sangre, sin paspartú: la foto llega al borde del recuadro. */
  .media[data-sangre] {
    padding: 0;
  }

  /* La ventana: ocupa el recuadro entero y recorta lo que sobresale. Hereda el
     radio para que, a sangre, la foto no asome por las esquinas. */
  .pantalla {
    position: relative;
    display: block;
    width: 100cqw;
    height: 100cqh;
    overflow: hidden;
    border-radius: inherit;
  }

  .media[data-sangre] .pantalla {
    border-radius: 8px;
  }

  /* Las hojas van apiladas en el mismo sitio y solo se ve una. El pase es un
     fundido: una publicación se hojea, no se desliza. */
  .hoja {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity var(--pase-fundido) var(--ease);
  }

  .hoja[data-vista] {
    opacity: 1;
  }

  /* El pliego mide lo que mide la hoja abierta —una página, dos o una
     grabación— encajada entera en el recuadro. Las páginas van juntas, sin
     canal entre medio: así se ve una doble página y no dos sueltas. */
  .pliego {
    display: flex;
    width: min(100cqw, calc(100cqh * var(--proporcion)));
    height: min(100cqh, calc(100cqw / var(--proporcion)));
  }

  .pliego :is(img, video) {
    display: block;
    flex: var(--proporcion) 1 0;
    min-width: 0;
    height: 100%;
    object-fit: contain;
    /* Un filete y no una sombra: marca dónde acaba el papel sin levantarlo. */
    outline: 1px solid rgb(0 0 0 / 0.06);
    outline-offset: -1px;
  }

  /* A sangre la hoja llena el recuadro y recorta lo que sobra por arriba y
     por abajo, nunca por los lados: el lomo queda en su sitio. */
  .hoja[data-ajuste='cubre'] .pliego {
    width: 100cqw;
    height: 100cqh;
  }

  .hoja[data-ajuste='cubre'] .pliego :is(img, video) {
    object-fit: cover;
    outline: none;
  }

  /* ——— Herramienta ———
     La grabación dentro de una ventana mínima: una barra con tres puntos y
     nada más. Basta para que se lea como pantalla y no como foto. */
  /* Sin paspartú: la ventana se apoya directo sobre el fondo. Va arriba del
     recuadro y no centrada, para que su borde quede a ras de la pestaña. */
  .media[data-pieza='herramienta'] {
    padding: 0;
    background: none;
  }

  .media[data-pieza='herramienta'] .hoja {
    align-items: start;
  }

  .media[data-pieza='herramienta'] .pliego {
    --barra: clamp(14px, 4.5cqh, 22px);
    flex-direction: column;
    /* La ventana entera (barra incluida) lleva la proporción de la grabación:
       así, con una grabación 16:10 en un recuadro 16:10, llena el ancho y su
       borde queda a ras del texto. Descontar la barra del alto la estrechaba
       y la dejaba centrada, desalineada. */
    width: min(100cqw, calc(100cqh * var(--proporcion)));
    height: auto;
    aspect-ratio: var(--proporcion);
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: calc(var(--barra) * 0.28);
    height: var(--barra);
    padding-inline: calc(var(--barra) * 0.5);
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    background: var(--surface-subtle);
  }

  .barra i {
    width: calc(var(--barra) * 0.32);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.14);
  }

  .media[data-pieza='herramienta'] .pliego :is(img, video) {
    /* Ocupa lo que deja la barra; recorta unos píxeles en vez de encoger. */
    flex: 1 1 0;
    width: 100%;
    height: auto;
    min-height: 0;
    aspect-ratio: auto;
    object-fit: cover;
    outline: none;
  }

  /* ——— Identidad ———
     Las aplicaciones de la marca de cuatro en cuatro, en una grilla que llena
     el paspartú. Cada celda recorta: lo que se enseña es la marca puesta en
     uso, no la página entera. La grilla solo se arma con varias láminas: una
     animación de la marca ya es una pieza entera y va a sangre. */
  .media[data-pieza='identidad'] .pliego:has(> img + img) {
    display: grid;
    grid-template: repeat(2, minmax(0, 1fr)) / repeat(2, minmax(0, 1fr));
    gap: clamp(6px, 2.5cqw, 16px);
    width: 100cqw;
    height: 100cqh;
  }

  .media[data-pieza='identidad'] .pliego:has(> img + img) img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Una hoja apagada sigue ahí, apilada y transparente, y recibiría el clic de
     la que se ve. Se le quita el puntero. */
  .hoja:not([data-vista]) {
    pointer-events: none;
  }

  /* El folio de la hoja, bajo el recuadro y a ras de su borde derecho. */
  .folio {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    margin-top: 0.75rem;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .folio span {
    font-weight: var(--weight-bold);
  }

  /* ——— La píldora ———
     Fija abajo, al centro. Nombra el proyecto que cruza la línea de lectura y
     cuenta cuántos hay. No se pulsa, así que no estorba al puntero ni al dedo. */
  .indicador {
    position: fixed;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    z-index: 20;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 1em;
    max-width: calc(100vw - 2rem);
    padding: 0.65em 1.3em;
    /* Radio fijo: `--radius-full` vale 50% y en una caja alargada da una elipse. */
    border-radius: 999px;
    /* El mismo contorno fino de la píldora de la cabecera. */
    border: 1px solid rgb(255 255 255 / 0.85);
    background: rgb(0 30 120 / 0.55);
    backdrop-filter: blur(10px);
    color: var(--white);
    font-size: var(--text-body-sm);
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
  }

  .indicador-titulo {
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: var(--weight-bold);
  }

  .cuenta {
    flex: none;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  /* ——— El visor ———
     La pieza a pantalla casi completa sobre un fondo oscuro. Nada de recuadro
     ni bisel aquí: eso era el paspartú del listado, y ampliar es justo quitarlo
     de en medio. */
  .visor {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    transition:
      opacity var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  /* Su `display: flex` pisa el `display: none` que el navegador le da al
     <dialog> cerrado. Con la página sin scroll no se notaba; ahora un visor
     invisible de 100vw ensanchaba la página y tapaba el clic. */
  .visor:not([open]) {
    display: none;
  }

  .visor[open] {
    opacity: 1;
  }

  /* Estado de partida del fundido: sin esto el visor aparece de golpe. */
  @starting-style {
    .visor[open] {
      opacity: 0;
    }
  }

  .visor::backdrop {
    background: rgb(0 8 40 / 0);
    transition:
      background var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  .visor[open]::backdrop {
    background: rgb(0 8 40 / 0.88);
  }

  @starting-style {
    .visor[open]::backdrop {
      background: rgb(0 8 40 / 0);
    }
  }

  .visor img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  .cerrar {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1rem, 2.5vw, 2rem);
    display: flex;
    padding: 0.6rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--white);
    cursor: var(--cursor);
    opacity: 0.7;
    transition: opacity var(--transition-normal);
  }

  .cerrar:hover {
    opacity: 1;
  }

  .cerrar svg {
    width: 22px;
    height: 22px;
  }

  .paginas {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 2.5vw, 2rem);
    translate: -50% 0;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .paginas span {
    font-weight: var(--weight-bold);
  }

  /* Con una sola lámina no hay nada que numerar. */
  .visor[data-unica] .paginas {
    display: none;
  }

  /* La columna de texto sale de los mockups: 27% contra 66%. Por debajo de este
     ancho se queda en menos de 180px —cuatro palabras por línea— y deja de
     leerse, así que ahí se apila: primero la pieza, después la ficha. Sin ficha
     fija, porque apilada no tiene a su lado nada que acompañar. */
  @media (max-width: 64rem) {
    .proyecto {
      --aire: clamp(2rem, 6vh, 3.5rem);
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--spacing-05);
    }

    .proyecto .ficha,
    .proyecto .media,
    .folio {
      grid-column: 1;
      grid-row: auto;
    }

    .media {
      order: 1;
      /* Tope para pantallas apaisadas: ahí el 16/10 a todo el ancho pedía más
         alto que la ventana entera. */
      max-height: 58svh;
    }

    .ficha {
      order: 2;
      position: static;
    }

    .proyecto[data-estado='fuera'] .ficha {
      opacity: 1;
      pointer-events: auto;
    }


    .folio {
      order: 3;
      margin-top: 0;
    }
  }
</style>

<script>
  // La lista. El guion no mueve nada: la página se desplaza sola, con la rueda
  // del navegador. Hace tres cosas: dice cuál es el proyecto que cruza la línea
  // de lectura (para la píldora y para aclarar las demás fichas), enciende lo
  // que está a la vista (las grabaciones y el pase de hojas) y abre el visor.
  if (!(window as any).__listaMontada) {
    (window as any).__listaMontada = true;

    const sinMovimiento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const proyectos = () => [...document.querySelectorAll<HTMLElement>('[data-proyecto]')];
    const hayLista = () => !!document.querySelector('[data-lista]');

    let activo = -1;
    let pase: number | undefined;
    let observador: IntersectionObserver | undefined;
    // Los proyectos que se ven ahora mismo. Solo ellos gastan batería y datos.
    const visibles = new Set<HTMLElement>();

    // ——— El pase de hojas ———
    // Una hoja cada `--pase-ritmo`, en todo proyecto que esté a la vista. Las
    // hojas se piden de una en una, la que se ve y la que viene: un documento de
    // cien páginas no se descarga por si acaso. El orden importa: primero se
    // levanta el diferido, después se pone la dirección.
    const cargar = (hoja?: Element) => {
      hoja?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.loading = 'eager';
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
      });
    };

    const mostrarHoja = (capa: HTMLElement, n: number) => {
      const hojas = [...capa.querySelectorAll('[data-hoja]')];
      if (!hojas.length) return;
      hojas.forEach((hoja, i) => hoja.toggleAttribute('data-vista', i === n));
      cargar(hojas[n]);
      cargar(hojas[(n + 1) % hojas.length]);
      capa.dataset.hojaVista = String(n);

      const folio = capa.querySelector('[data-folio]');
      if (folio) folio.textContent = String(n + 1).padStart(2, '0');
    };

    const ritmo = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--pase-ritmo')) *
        1000 || 3200;

    const visorAbierto = () => !!visor()?.open;

    // Con movimiento reducido no hay pase: la primera hoja se queda quieta y
    // el resto se ve en el visor, pasándolas a mano.
    const programarPase = () => {
      clearTimeout(pase);
      if (sinMovimiento() || !hayLista()) return;

      pase = window.setTimeout(() => {
        // Con el visor abierto el pase espera: lo de detrás está tapado.
        if (!visorAbierto()) {
          visibles.forEach((capa) => {
            const total = capa.querySelectorAll('[data-hoja]').length;
            if (total > 1) mostrarHoja(capa, (Number(capa.dataset.hojaVista ?? 0) + 1) % total);
          });
        }
        programarPase();
      }, ritmo());
    };

    // Una grabación corre solo mientras su proyecto se ve. Con movimiento
    // reducido no arranca sola.
    const encender = (capa: HTMLElement, visible: boolean) => {
      capa.querySelectorAll('video').forEach((video) => {
        if (visible && !sinMovimiento()) {
          if (video.dataset.src) {
            video.src = video.dataset.src;
            video.removeAttribute('data-src');
          }
          // Al llegar sin recarga, Astro arma la página en un documento aparte
          // y la grabación que ya traía `src` intenta cargar ahí, falla y no
          // vuelve a intentarlo al entrar en la página. Se le pide de nuevo.
          if (video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) video.load();
          video.preload = 'auto';
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    };

    // ——— El proyecto que se lee ———
    // El último cuyo borde de arriba ya pasó la línea de lectura, a un 45% del
    // alto de la ventana. Entre dos proyectos sigue siendo el que acaba de
    // pasar, y al llegar al final de la página, el último.
    const medir = () => {
      const lista = proyectos();
      if (!lista.length) return;

      const linea = innerHeight * 0.45;
      let nuevo = 0;
      lista.forEach((proyecto, i) => {
        if (proyecto.getBoundingClientRect().top <= linea) nuevo = i;
      });
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) {
        nuevo = lista.length - 1;
      }
      if (nuevo === activo) return;

      activo = nuevo;
      lista.forEach((proyecto, i) => {
        proyecto.dataset.estado = i === activo ? 'activo' : 'fuera';
      });

      const titulo = document.querySelector<HTMLElement>('[data-indicador-titulo]');
      const numero = document.querySelector<HTMLElement>('[data-indicador-n]');
      if (titulo) {
        titulo.textContent = lista[activo].querySelector('h2')?.textContent ?? '';
        // El rótulo cambia con un fundido corto: sin él, el texto salta.
        if (!sinMovimiento()) {
          titulo.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 250,
            easing: 'cubic-bezier(0.25, 0.8, 0.25, 1)',
          });
        }
      }
      if (numero) numero.textContent = String(activo + 1).padStart(2, '0');
    };

    // Se mide en el propio evento y sin esperar al siguiente cuadro: son
    // quince `getBoundingClientRect` y, además, un `requestAnimationFrame` no
    // corre en una pestaña a la que el navegador le ha quitado el cuadro.
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', medir);

    // ——— El visor ———
    // La pieza a pantalla casi completa. Mientras está abierto, el pase espera
    // y las flechas pasan las páginas de la pieza.
    const visor = () => document.querySelector<HTMLDialogElement>('[data-visor]');

    let laminasDelVisor: string[] = [];
    let laminaDelVisor = 0;

    const pintarVisor = () => {
      const caja = visor();
      const img = caja?.querySelector<HTMLImageElement>('[data-visor-img]');
      if (!caja || !img) return;

      img.src = laminasDelVisor[laminaDelVisor];
      caja.querySelector('[data-visor-indice]')!.textContent = String(laminaDelVisor + 1);
      caja.querySelector('[data-visor-total]')!.textContent = String(laminasDelVisor.length);
      caja.toggleAttribute('data-unica', laminasDelVisor.length < 2);
    };

    // `desde` es la lámina que se pulsó: el pase está en marcha, así que abrir
    // siempre por la primera sería abrir otra distinta de la que se señaló. Sin
    // lámina pulsada —desde el teclado— se abre por la hoja que está a la vista.
    const abrirVisor = (desde?: Element | null, carta?: Element | null) => {
      const caja = visor();
      carta ??= desde?.closest('[data-proyecto]') ?? proyectos()[Math.max(activo, 0)];
      const laminas = [...(carta?.querySelectorAll<HTMLImageElement>('img[data-lamina]') ?? [])];
      const pulsada =
        (desde as HTMLImageElement | null | undefined) ??
        carta?.querySelector<HTMLImageElement>('[data-hoja][data-vista] img[data-lamina]');
      if (!caja || !laminas.length) return;

      laminasDelVisor = laminas.map((l) => l.src || l.dataset.src || '');
      laminaDelVisor = Math.max(0, Number(pulsada?.dataset.lamina ?? 0));

      const img = caja.querySelector<HTMLImageElement>('[data-visor-img]');
      if (img) img.alt = laminas[0].alt || carta?.querySelector('h2')?.textContent || '';

      pintarVisor();
      caja.showModal();
      // Marca en <html> que hay una pieza ampliada encima de todo.
      document.documentElement.dataset.visorAbierto = 'si';
    };

    const pasarEnElVisor = (paso: number) => {
      if (laminasDelVisor.length < 2) return;
      laminaDelVisor =
        (laminaDelVisor + paso + laminasDelVisor.length) % laminasDelVisor.length;
      pintarVisor();
    };

    // Solo el visor tiene teclas propias: en la lista, flechas, espacio, Re Pág
    // e Inicio/Fin ya las resuelve el navegador.
    document.addEventListener('keydown', (evento) => {
      if (!visorAbierto()) return;

      if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrarVisor();
      } else if (evento.key === 'ArrowRight' || evento.key === 'ArrowDown') {
        evento.preventDefault();
        pasarEnElVisor(1);
      } else if (evento.key === 'ArrowLeft' || evento.key === 'ArrowUp') {
        evento.preventDefault();
        pasarEnElVisor(-1);
      }
    });

    document.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;
      const caja = visor();

      if (objetivo.closest('[data-visor-cerrar]')) return cerrarVisor();
      // Clic en el fondo del visor —fuera de la pieza— también cierra.
      if (caja?.open && objetivo === caja) return cerrarVisor();

      if (objetivo.closest('[data-ampliar]')) {
        return abrirVisor(null, objetivo.closest('[data-proyecto]'));
      }

      // Pulsar la pieza la amplía. Si el clic cae en el pliego y no en la
      // lámina misma, se abre por la hoja que está a la vista.
      const pantalla = objetivo.closest('.pantalla');
      if (pantalla && !visorAbierto()) {
        abrirVisor(objetivo.closest('img[data-lamina]'), pantalla.closest('[data-proyecto]'));
      }
    });

    // Todo cierre pasa por aquí. El evento `close` del <dialog> se despacha en
    // una tarea aparte y hay entornos donde no llega; colgar de él la limpieza
    // dejaba la marca puesta para siempre. Se mantiene enganchado igualmente,
    // por si el cierre viene del navegador y no de nosotros, y como la función
    // tiene nombre, engancharla dos veces no la ejecuta dos veces.
    const alCerrarVisor = () => {
      delete document.documentElement.dataset.visorAbierto;
    };

    const cerrarVisor = () => {
      visor()?.close();
      alCerrarVisor();
    };

    // El `close` del <dialog> no burbujea: hay que engancharlo al propio
    // elemento, y volver a hacerlo cada vez que Astro reemplaza el <body>.
    const escucharElCierre = () => {
      visor()?.addEventListener('close', alCerrarVisor);
    };

    // Al entrar en la página —o al volver a ella sin recarga— se arma todo de
    // nuevo: el <body> es otro y los proyectos también.
    const arrancar = () => {
      activo = -1;
      visibles.clear();
      observador?.disconnect();
      if (!hayLista()) return clearTimeout(pase);

      observador = new IntersectionObserver(
        (entradas) =>
          entradas.forEach(({ target, isIntersecting }) => {
            const capa = target as HTMLElement;
            if (isIntersecting) {
              visibles.add(capa);
              // Deja pedida la hoja que viene antes de que le toque.
              mostrarHoja(capa, Number(capa.dataset.hojaVista ?? 0));
            } else {
              visibles.delete(capa);
            }
            encender(capa, isIntersecting);
          }),
        // Un margen de un quinto de pantalla: la grabación ya corre cuando asoma.
        { rootMargin: '20% 0px', threshold: 0 },
      );
      proyectos().forEach((proyecto) => observador!.observe(proyecto));

      escucharElCierre();
      medir();
      programarPase();
    };

    document.addEventListener('astro:page-load', arrancar);

    // Y también ahora mismo: en la primera carga, el router de Astro puede
    // haber lanzado ya su evento antes de que este módulo llegara a existir.
    arrancar();
  }
</script>
