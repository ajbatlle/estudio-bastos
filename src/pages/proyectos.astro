---
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { getCollection } from 'astro:content';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

// Las láminas de cada serie se buscan en el disco: un documento puede tener
// cien páginas y enumerarlas en el .md no lo leería nadie. Solo cuentan las
// numeradas con tres cifras, que son las que escribe el pipeline; así, si queda
// un archivo viejo de otra numeración, no se cuela en el pase.
const laminasDeLaSerie = (prefijo: string) =>
  readdirSync('public/media')
    .filter((archivo) => new RegExp(`^${prefijo}-\\d{3}\\.webp$`).test(archivo))
    .sort();

// Cada lámina lleva su propia proporción, leída del archivo en el build. Es lo
// que permite que dentro de un mismo pase una página horizontal se vea grande y
// una vertical se vea alta: si el marco lo fijara la primera, todas las demás
// tendrían que encogerse hasta caber en el hueco de aquella.
const piezas = new Map<string, { archivo: string; proporcion: number }[]>();

const esVideo = (archivo: string) => /\.(mp4|webm)$/.test(archivo);

// Un video que se rehace conserva su nombre, y el navegador seguiría sirviendo
// el de la caché. La fecha del archivo en la dirección obliga a pedirlo de nuevo.
const version = (archivo: string) =>
  Math.round(statSync(`public/media/${archivo}`).mtimeMs).toString(36);

// sharp no lee video, así que la proporción se saca de la cabecera del MP4: la
// caja `tkhd` guarda el ancho y el alto de la pista en sus últimos ocho bytes,
// en coma fija 16.16. Basta para no tener que escribirla a mano en el .md.
const proporcionDelVideo = (archivo: string) => {
  const datos = readFileSync(`public/media/${archivo}`);
  let inicio = datos.indexOf('tkhd');
  while (inicio > 0) {
    const fin = inicio - 4 + datos.readUInt32BE(inicio - 4);
    const ancho = datos.readUInt32BE(fin - 8) / 65536;
    const alto = datos.readUInt32BE(fin - 4) / 65536;
    if (ancho && alto) return ancho / alto;
    inicio = datos.indexOf('tkhd', inicio + 4);
  }
  return 16 / 9;
};

for (const proyecto of proyectos) {
  const { media, serie } = proyecto.data;
  const archivos = serie
    ? laminasDeLaSerie(serie)
    : media
      ? Array.isArray(media)
        ? media
        : [media]
      : [];

  const medidas = await Promise.all(
    archivos.map(async (archivo) => {
      if (esVideo(archivo)) return { archivo, proporcion: proporcionDelVideo(archivo) };
      const { width, height } = await sharp(`public/media/${archivo}`).metadata();
      return { archivo, proporcion: width && height ? width / height : 1.6 };
    }),
  );

  if (medidas.length) piezas.set(proyecto.id, medidas);
}

// Los logos se igualan por peso, no por ancho: todos ocupan la misma superficie.
// A igual ancho, uno casi cuadrado como el de Mano y Aguja se veía diminuto al
// lado del de Tisvol, que mide ocho veces más de ancho que de alto. El alto
// tiene un tope —la pestaña no crece hacia abajo, que de ella cuelga la ficha—
// y la pestaña toma el ancho de su logo más un margen a cada lado.
const SUPERFICIE = 2300, ALTO_MAXIMO = 42, MARGEN = 22;
const logos = new Map<string, { ancho: number; alto: number; pestana: number }>();

for (const proyecto of proyectos) {
  if (!proyecto.data.logo) continue;
  const { width, height } = await sharp(`public/media/logos/${proyecto.data.logo}.webp`).metadata();
  const proporcion = width && height ? width / height : 3;
  const alto = Math.min(ALTO_MAXIMO, Math.sqrt(SUPERFICIE / proporcion));
  const ancho = alto * proporcion;
  logos.set(proyecto.id, {
    ancho: Math.round(ancho),
    alto: Math.round(alto),
    pestana: Math.round(ancho + MARGEN * 2),
  });
}

type Lamina = { archivo: string; proporcion: number; numero: number };
type Hoja = { laminas: Lamina[]; proporcion: number; ajuste: 'cubre' | 'contiene' };

// Una página suelta mide menos de 1,15 de ancho por alto; una doble página, más.
const SUELTA = 1.15;

// Las hojas son lo que se ve de una vez en el recuadro. Una publicación se mira
// abierta, así que las páginas sueltas se casan de dos en dos —salvo la
// portada, que va sola como en el libro—. Una identidad se enseña en grilla de
// cuatro. Una herramienta es una sola grabación.
const hojasDe = (pieza: string, laminas: Lamina[]): Hoja[] => {
  const juntar = (grupo: Lamina[]): Hoja => {
    const proporcion = grupo.reduce((suma, l) => suma + l.proporcion, 0);
    return {
      laminas: grupo,
      proporcion,
      // A sangre solo lo que ya es apaisado: una portada vertical recortada a
      // 16/10 perdería más de la mitad, así que esa se queda entera.
      // Un video que no es una grabación de pantalla es una pieza ya montada
      // —fotos del impreso— y también va a sangre.
      ajuste:
        (pieza === 'catalogo' && proporcion >= SUELTA) ||
        (pieza !== 'herramienta' && grupo.some((l) => esVideo(l.archivo)))
          ? 'cubre'
          : 'contiene',
    };
  };

  if (pieza === 'identidad') {
    const hojas: Hoja[] = [];
    for (let i = 0; i < laminas.length; i += 4) {
      hojas.push({ ...juntar(laminas.slice(i, i + 4)), ajuste: 'cubre' });
    }
    return hojas;
  }

  if (pieza === 'herramienta') return laminas.map((l) => juntar([l]));

  const hojas: Hoja[] = [];
  let pendiente: Lamina | null = null;
  for (const [i, lamina] of laminas.entries()) {
    const suelta = lamina.proporcion < SUELTA;
    // La contraportada también va sola, si no le queda pareja.
    if (!suelta || i === 0 || (i === laminas.length - 1 && !pendiente)) {
      if (pendiente) hojas.push(juntar([pendiente]));
      pendiente = null;
      hojas.push(juntar([lamina]));
    } else if (pendiente) {
      hojas.push(juntar([pendiente, lamina]));
      pendiente = null;
    } else {
      pendiente = lamina;
    }
  }
  if (pendiente) hojas.push(juntar([pendiente]));
  return hojas;
};

// Folio con dos cifras: «03 / 24».
const folio = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Proyectos"
  description="Proyectos del estudio: identidad, publicaciones editoriales, plataformas digitales y otros productos de comunicación."
  accion="Volver al inicio"
  accionHref={import.meta.env.BASE_URL}
>
  <h1 class="visually-hidden">Proyectos</h1>

  {/* Una baraja, no un listado: los proyectos están apilados y solo se ve el de
      arriba, con el siguiente asomando por detrás. Cada capa ocupa el escenario
      entero y lleva su ficha y su lámina juntas, así que las dos se relevan a la
      vez. El estado de cada capa lo pone el guion en `data-estado`. */}
  <div class="escenario" data-baraja aria-roledescription="carrusel">
    {
      proyectos.map((proyecto, indice) => {
        const { titulo, descripcion, tipo, rol, anio, enlace, enlaceTexto, mediaAlt, pieza } =
          proyecto.data;

        const hojas = hojasDe(
          pieza,
          (piezas.get(proyecto.id) ?? []).map((l, numero) => ({ ...l, numero })),
        );

        return (
          <article
            class="proyecto container"
            data-proyecto
            data-estado={indice === 0 ? 'activo' : indice === 1 ? 'siguiente' : indice === 2 ? 'fondo' : 'oculto'}
            aria-label={`${indice + 1} de ${proyectos.length}: ${titulo}`}
          >
            <div class="ficha">
              <h2>{titulo}</h2>
              {descripcion && <p class="descripcion">{descripcion}</p>}

              <dl class="meta">
                <dt class="visually-hidden">Tipo</dt>
                <dd>{tipo}</dd>
                {/* Si el rol dice lo mismo que el tipo, o no está, la línea sobra. */}
                {rol && rol !== tipo && (
                  <>
                    <dt class="visually-hidden">Rol</dt>
                    <dd>{rol}</dd>
                  </>
                )}
                <dt class="visually-hidden">Año</dt>
                <dd>{anio}</dd>
              </dl>

              {/* La pieza se amplía pulsándola, pero con teclado no hay dónde
                  pulsar: la lámina no puede ser un botón sin perder el
                  arrastre, que arranca justo ahí. Este botón es esa puerta, y
                  solo aparece al tabular. */}
              <button type="button" class="visually-hidden" data-ampliar>
                Ver la pieza ampliada
              </button>

              {enlace && (
                <a
                  class="enlace"
                  href={enlace.startsWith('/') ? `${base}${enlace.slice(1)}` : enlace}
                  target={enlace.startsWith('/') ? undefined : '_blank'}
                  rel={enlace.startsWith('/') ? undefined : 'noopener'}
                >
                  {enlaceTexto ?? enlace}
                  <svg
                    class="flecha"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.5 11.5 11.5 4.5" />
                    <path d="M5.5 4.5h6v6" />
                  </svg>
                  {!enlace.startsWith('/') && (
                    <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                  )}
                </a>
              )}
            </div>

            {/* El recuadro mide lo mismo en todos los proyectos; lo que cambia
                es cómo se enseña la pieza dentro, según `data-pieza`. Las hojas
                se pasan de una en una, con fundido: una doble página se mira
                abierta y quieta, no cayendo. */}
            <div
              class="media"
              data-pieza={pieza}
              data-sangre={hojas.some((h) => h.ajuste === 'cubre') ? '' : undefined}
            >
              {hojas.length > 0 && (
                <span class="pantalla">
                  {hojas.map((hoja, turno) => (
                    <span
                      class="hoja"
                      data-hoja
                      data-vista={turno === 0 ? '' : undefined}
                      data-ajuste={hoja.ajuste}
                      style={`--proporcion: ${hoja.proporcion.toFixed(4)}`}
                    >
                      <span class="pliego">
                        {pieza === 'herramienta' && (
                          <span class="barra" aria-hidden="true">
                            <i />
                            <i />
                            <i />
                          </span>
                        )}
                        {/* Solo la primera hoja trae `src`: es la que se ve al
                            llegar. Las demás esperan en `data-src` y se piden
                            cuando les toca. Sin esto se descargarían las 283
                            de golpe: la carga diferida no sirve aquí, porque
                            todas las capas están dentro del viewport aunque
                            estén apagadas. */}
                        {hoja.laminas.map(({ archivo, proporcion, numero }) =>
                          esVideo(archivo) ? (
                            // Un video real y no un WebP animado: a igual
                            // nitidez pesa varias veces menos. Lo arranca y lo
                            // para el guion según el proyecto esté arriba o no.
                            <video
                              src={turno === 0 ? `${base}media/${archivo}?v=${version(archivo)}` : undefined}
                              data-src={turno === 0 ? undefined : `${base}media/${archivo}?v=${version(archivo)}`}
                              style={`--proporcion: ${proporcion.toFixed(4)}`}
                              aria-label={mediaAlt}
                              muted
                              loop
                              playsinline
                              preload={indice === 0 ? 'auto' : 'none'}
                            />
                          ) : (
                          <img
                            src={turno === 0 ? `${base}media/${archivo}` : undefined}
                            data-src={turno === 0 ? undefined : `${base}media/${archivo}`}
                            alt={numero === 0 ? (mediaAlt ?? '') : ''}
                            style={`--proporcion: ${proporcion.toFixed(4)}`}
                            data-lamina={numero}
                            loading={indice < 3 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                          ),
                        )}
                      </span>
                    </span>
                  ))}
                </span>
              )}
            </div>

            {/* El folio va en la línea del índice, a la derecha: a la
                izquierda, en qué proyecto estás; aquí, en qué hoja. */}
            {hojas.length > 1 && (
              <p class="folio" aria-hidden="true">
                <span data-folio>01</span> / {folio(hojas.length)}
              </p>
            )}
          </article>
        );
      })
    }

    {/* La pestaña del cliente es fija: ni se mueve ni se releva con la baraja.
        Lo que cambia es lo que hay dentro. Va clavada arriba del escenario, en
        el eje de la caja de texto, y las cartas arrancan por debajo: es el
        único punto que no se mueve cuando cambia el alto de una ficha o el de
        una lámina. */}
    <div class="capa-pestana container" aria-hidden="true">
      <span
        class="pestana"
        data-pestana
        style={`--pestana-ancho: ${logos.get(proyectos[0]?.id)?.pestana ?? 150}px`}
      >
        {proyectos.map((proyecto, indice) => {
          const medida = logos.get(proyecto.id);
          return medida ? (
            <img
              src={`${base}media/logos/${proyecto.data.logo}.webp`}
              alt=""
              width={medida.ancho}
              height={medida.alto}
              data-logo={indice}
              data-pestana-ancho={medida.pestana}
              data-sitio={indice === 0 ? 'centro' : 'arriba'}
            />
          ) : null;
        })}
      </span>
    </div>

    {/* La otra vista: todos los proyectos de una vez, en grilla. Pulsar uno
        vuelve a la baraja, abierta en ese. Las miniaturas no traen `src`: se
        piden recién al abrir la grilla, que la mayoría de las visitas no abre. */}
    <div class="grilla container" data-grilla inert>
      <ul>
        {proyectos.map((proyecto, indice) => {
          const primera = piezas.get(proyecto.id)?.[0];
          const ruta = primera && `${base}media/${primera.archivo}`;
          return (
            <li>
              {/* Sin texto: la grilla es solo las piezas en movimiento. El
                  título queda para quien no las ve. */}
              <button
                type="button"
                class="miniatura"
                data-ir={indice}
                aria-label={proyecto.data.titulo}
              >
                <span class="mini-media">
                  {primera &&
                    (esVideo(primera.archivo) ? (
                      // Corre solo mientras está a la vista. Antes de arrancar
                      // —o con movimiento reducido— muestra el cuadro de `#t`.
                      <video
                        data-src={`${ruta}?v=${version(primera.archivo)}#t=${proyecto.data.miniatura ?? 0.1}`}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                      />
                    ) : (
                      <img data-src={ruta} alt="" decoding="async" />
                    ))}
                </span>
              </button>
            </li>
          );
        })}
      </ul>
    </div>

    <p class="indice container">
      <span data-indice>1</span> / {proyectos.length}
      <button
        type="button"
        class="vista"
        data-vista-cambiar
        aria-pressed="false"
        aria-label="Ver todos los proyectos"
      >
        {/* Cuatro cuadros en la baraja; uno solo en la grilla, que es a donde
            lleva el botón en cada caso. */}
        <svg class="icono-grilla" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="2" y="2" width="5" height="5" rx="1" />
          <rect x="9" y="2" width="5" height="5" rx="1" />
          <rect x="2" y="9" width="5" height="5" rx="1" />
          <rect x="9" y="9" width="5" height="5" rx="1" />
        </svg>
        <svg class="icono-baraja" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="2" y="3" width="12" height="10" rx="1.5" />
        </svg>
      </button>
    </p>

    {/* La seña: dice que se avanza bajando, que es lo único que la baraja no
        cuenta por sí sola. El isotipo hace de rueda porque en este sitio el
        isotipo ya es el cursor. Se retira sola en cuanto se avanza una vez. */}
    <div class="sena" data-sena aria-hidden="true">
      <span class="raton">
        <img src={`${base}brand/cursor-blanco.svg`} alt="" width="32" height="32" />
      </span>
    </div>

    {/* Con rueda, teclado y dedo se avanza sin botones, pero un lector de
        pantalla necesita algo que pulsar. Están ahí y solo se ven al tabular. */}
    <div class="mandos container">
      <button type="button" class="visually-hidden" data-anterior>Proyecto anterior</button>
      <button type="button" class="visually-hidden" data-siguiente>Proyecto siguiente</button>
    </div>
  </div>

  {/* El visor. Va fuera del escenario porque no es una capa más de la baraja:
      se pone delante de todo. Es un <dialog>, así que el navegador ya trae el
      cierre con Esc, el foco atrapado dentro y el resto de la página inerte. */}
  <dialog class="visor" data-visor aria-label="Pieza ampliada">
    <button type="button" class="cerrar" data-visor-cerrar aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <img data-visor-img alt="" />

    <p class="paginas">
      <span data-visor-indice>1</span> / <span data-visor-total>1</span>
    </p>
  </dialog>
</Base>

<style>
  /* La página deja de tener scroll: es una sola pantalla, como el juego. Estas
     reglas solo viajan con esta página, así que no tocan el resto del sitio. */
  :global(html:has(.escenario)),
  :global(html:has(.escenario) body) {
    overflow: hidden;
  }

  .escenario {
    position: relative;
    flex: 1;

    /* Las dos franjas que las cartas no pueden ocupar: la pestaña arriba y el
       índice abajo. Van en variables porque quien las respeta es el `inset` de
       cada carta —el relleno del escenario no les vale, ya que una caja
       absoluta se mide contra la caja de relleno, no contra la de contenido—. */
    --pestana-alto: 60px;
    --pestana-aire: clamp(1rem, 2.6vw, 2.25rem);
    --indice-hueco: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  /* Cada proyecto es una capa que ocupa el escenario entero. Apiladas en el
     mismo sitio, lo que las distingue es el estado. */
  .proyecto {
    position: absolute;
    inset: 0 0 var(--indice-hueco) 0;
    display: grid;
    /* Proporción tomada de los mockups: ~27% / ~66%, con un canal entre medio. */
    grid-template-columns: minmax(0, 27fr) minmax(0, 66fr);
    /* La fila mide lo que mide el recuadro, no lo que mida la ficha más larga:
       si la dejara crecer con el texto, cada proyecto pondría su borde superior
       a una altura distinta y la pestaña bailaría al pasar de uno a otro. */
    grid-template-rows: var(--fila-alto, auto);
    gap: 7%;
    align-content: center;
    /* Las dos columnas arrancan a la misma altura: es lo que permite que la
       pestaña quede a ras del borde superior del recuadro y que la ficha se lea
       colgando de ella, en vez de flotar centrada por su cuenta. */
    align-items: start;

    transition:
      translate var(--baraja-paso) var(--ease),
      scale var(--baraja-paso) var(--ease),
      opacity var(--baraja-paso) var(--ease);
  }

  /* ——— Los cuatro estados de la baraja ———
     Arriba, asomando, al fondo, y fuera. Tocar el gesto es tocar estos cuatro
     bloques y nada más. */
  /* El desplazamiento del arrastre se suma al de cada estado: la baraja entera
     acompaña al cursor mientras se tira de ella. */
  /* Quieta, la carta de arriba no lleva ni `translate` ni `scale`. No es un
     detalle: cualquier valor distinto de `none` crea contexto de apilamiento, y
     ahí el título en `difference` dejaría de ver el fondo de la página. El
     desplazamiento del arrastre se le pone solo mientras se arrastra. */
  .proyecto[data-estado='activo'] {
    z-index: 3;
    translate: none;
    scale: none;
    opacity: 1;
  }

  .escenario[data-arrastrando] .proyecto[data-estado='activo'] {
    translate: 0 var(--arrastre, 0px);
  }

  /* Sin cartas asomando por detrás: el siguiente espera invisible, un poco
     más abajo, y entra con un fundido al pasar. */
  .proyecto[data-estado='siguiente'] {
    z-index: 2;
    translate: 0 calc(4% + var(--arrastre, 0px) * 0.6);
    scale: none;
    opacity: 0;
  }

  .proyecto[data-estado='fondo'] {
    z-index: 1;
    translate: 0 4%;
    scale: none;
    opacity: 0;
  }

  .proyecto[data-estado='oculto'] {
    z-index: 0;
    translate: 0 4%;
    scale: none;
    opacity: 0;
  }

  /* Los ya vistos salen por arriba, no por donde entraron: así se lee que la
     baraja avanza en un sentido. */
  .proyecto[data-estado='pasado'] {
    z-index: 0;
    translate: 0 -4%;
    scale: none;
    opacity: 0;
  }

  /* Mientras se arrastra no hay transición: la capa tiene que ir pegada al
     cursor, no persiguiéndolo con medio segundo de retraso. */
  .escenario[data-arrastrando] .proyecto {
    transition: none;
  }

  /* Solo se lee la ficha de arriba. Las de detrás dejarían un texto fantasma
     bajo el que se está leyendo. */
  .proyecto:not([data-estado='activo']) {
    pointer-events: none;
  }

  .proyecto:not([data-estado='activo']) .ficha {
    opacity: 0;
  }

  .ficha {
    opacity: 1;
    /* El hueco de la pestaña: el texto arranca justo debajo de ella, en el
       mismo eje, para que las dos se lean como un solo bloque. */
    padding-top: calc(var(--pestana-alto) + var(--pestana-aire));
    /* Entra un poco después que la lámina: primero se ve la pieza, después se
       lee de qué va. */
    transition: opacity var(--baraja-paso) var(--ease) 0.12s;
  }

  /* ——— La pestaña del cliente ———
     Capa aparte, clavada arriba a la izquierda del escenario. Antes iba a la
     altura del borde superior de la lámina, y eso solo aguantaba mientras la
     ficha fuera más baja que la lámina: en cuanto crecía, la pestaña acababa
     encima del texto. */
  .capa-pestana {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  /* El alto es fijo —de él cuelga la ficha, y el texto no puede moverse al
     pasar de proyecto—; el ancho se ajusta a cada logo. Mismo recuadro blanco
     que la tira de logos del manifiesto, porque los logos están hechos para
     fondo claro: sobre el azul varios se desvanecen. */
  /* `--pestana-y` la mide el guion: es el borde superior del recuadro, que
     depende de la retícula y no de un número que se pueda escribir aquí. Se
     calcula una vez y vale para los diez, porque todos los recuadros miden
     igual: la pestaña no se mueve al cambiar de proyecto. */
  .pestana {
    position: absolute;
    top: var(--pestana-y, 0px);
    left: 0;
    width: var(--pestana-ancho, 150px);
    height: var(--pestana-alto);
    overflow: hidden;
    transition:
      width var(--pestana-paso) var(--ease),
      opacity var(--pestana-paso) var(--ease);
    background: var(--white);
    border-radius: 8px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.07),
      0 1px 2px rgb(0 0 0 / 0.06),
      0 6px 16px rgb(0 0 0 / 0.1);
  }

  .pestana[data-vacia] {
    opacity: 0;
  }

  /* Los logos van apilados en el mismo sitio y solo cambia dónde está cada uno:
     el que se va baja, el que llega cae desde arriba. `inset` con `margin: auto`
     los centra; el tamaño de cada uno viene calculado del build. */
  .pestana img {
    position: absolute;
    inset: 0;
    margin: auto;
    display: block;
    object-fit: contain;
    transition:
      translate var(--pestana-paso) var(--ease),
      opacity var(--pestana-paso) var(--ease);
  }

  .pestana img[data-sitio='arriba'] {
    translate: 0 -160%;
    opacity: 0;
  }

  .pestana img[data-sitio='centro'] {
    translate: 0 0;
    opacity: 1;
  }

  .pestana img[data-sitio='abajo'] {
    translate: 0 160%;
    opacity: 0;
  }

  /* El título toma su color del fondo, como el manifiesto: blanco en
     `difference` sobre el mesh. Solo funciona con la carta quieta —durante el
     relevo la capa lleva opacidad y eso corta la fusión—, así que el título
     entra blanco y toma el ámbar al asentarse. */
  h2 {
    mix-blend-mode: difference;
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  /* Apretada a propósito: la ficha tiene que caber en el alto del recuadro,
     que es lo que fija la fila. Con las separaciones anteriores —1,4em y un
     interlineado de 1,65— se pasaba de largo y había que recortarla. */
  .descripcion {
    margin-top: 1em;
  }

  .meta {
    margin-top: 1em;
  }

  .descripcion,
  .meta {
    font-size: var(--text-body-sm);
    line-height: 1.55;
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1em;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    line-height: 1.65;
  }

  .flecha {
    width: 0.9em;
    height: 0.9em;
    flex: none;
  }

  /* Plano: ni bisel hundido ni sombras bajo las láminas. El recuadro es un
     papel gris claro y la pieza se apoya en él sin levantarse. */
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    /* El recuadro se declara contenedor de consulta para que cada hoja pueda
       medirse contra él —`cqw` y `cqh` son su caja interior, ya descontado el
       paspartú— y calcular por sí misma cuánto tiene que encoger. */
    container-type: size;
    background: var(--surface-subtle);
    border-radius: 8px;
    /* La pieza no toca el borde: el recuadro actúa de paspartú. En porcentaje
       para que el aire crezca con él. */
    padding: clamp(10px, 4%, 40px);
  }

  /* A sangre, sin paspartú: la foto llega al borde del recuadro. */
  .media[data-sangre] {
    padding: 0;
  }

  /* La ventana: ocupa el recuadro entero y recorta lo que sobresale. Hereda el
     radio para que, a sangre, la foto no asome por las esquinas. */
  .pantalla {
    position: relative;
    display: block;
    width: 100cqw;
    height: 100cqh;
    overflow: hidden;
    border-radius: inherit;
  }

  .media[data-sangre] .pantalla {
    border-radius: 8px;
  }

  /* Las hojas van apiladas en el mismo sitio y solo se ve una. El pase es un
     fundido: una publicación se hojea, no se desliza. */
  .hoja {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity var(--pase-fundido) var(--ease);
  }

  .hoja[data-vista] {
    opacity: 1;
  }

  /* El pliego mide lo que mide la hoja abierta —una página, dos o una
     grabación— encajada entera en el recuadro. Las páginas van juntas, sin
     canal entre medio: así se ve una doble página y no dos sueltas. */
  .pliego {
    display: flex;
    width: min(100cqw, calc(100cqh * var(--proporcion)));
    height: min(100cqh, calc(100cqw / var(--proporcion)));
  }

  .pliego :is(img, video) {
    display: block;
    flex: var(--proporcion) 1 0;
    min-width: 0;
    height: 100%;
    object-fit: contain;
    /* Un filete y no una sombra: marca dónde acaba el papel sin levantarlo. */
    outline: 1px solid rgb(0 0 0 / 0.06);
    outline-offset: -1px;
  }

  /* A sangre la hoja llena el recuadro y recorta lo que sobra por arriba y
     por abajo, nunca por los lados: el lomo queda en su sitio. */
  .hoja[data-ajuste='cubre'] .pliego {
    width: 100cqw;
    height: 100cqh;
  }

  .hoja[data-ajuste='cubre'] .pliego :is(img, video) {
    object-fit: cover;
    outline: none;
  }

  /* ——— Herramienta ———
     La grabación dentro de una ventana mínima: una barra con tres puntos y
     nada más. Basta para que se lea como pantalla y no como foto. */
  /* Sin paspartú: la ventana se apoya directo sobre el fondo. Va arriba del
     recuadro y no centrada, para que su borde quede a ras de la pestaña. */
  .media[data-pieza='herramienta'] {
    padding: 0;
    background: none;
  }

  .media[data-pieza='herramienta'] .hoja {
    align-items: start;
  }

  .media[data-pieza='herramienta'] .pliego {
    --barra: clamp(14px, 4.5cqh, 22px);
    flex-direction: column;
    width: min(100cqw, calc((100cqh - var(--barra)) * var(--proporcion)));
    height: auto;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: calc(var(--barra) * 0.28);
    height: var(--barra);
    padding-inline: calc(var(--barra) * 0.5);
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    background: var(--surface-subtle);
  }

  .barra i {
    width: calc(var(--barra) * 0.32);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.14);
  }

  .media[data-pieza='herramienta'] .pliego :is(img, video) {
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: var(--proporcion);
    outline: none;
  }

  /* ——— Identidad ———
     Las aplicaciones de la marca de cuatro en cuatro, en una grilla que llena
     el paspartú. Cada celda recorta: lo que se enseña es la marca puesta en
     uso, no la página entera. La grilla solo se arma con varias láminas: una
     animación de la marca ya es una pieza entera y va a sangre. */
  .media[data-pieza='identidad'] .pliego:has(> img + img) {
    display: grid;
    grid-template: repeat(2, minmax(0, 1fr)) / repeat(2, minmax(0, 1fr));
    gap: clamp(6px, 2.5cqw, 16px);
    width: 100cqw;
    height: 100cqh;
  }

  .media[data-pieza='identidad'] .pliego:has(> img + img) img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* El folio de la hoja, en la línea del índice y a ras del borde derecho del
     recuadro. Sale con su proyecto porque vive dentro de la capa. */
  .folio {
    position: absolute;
    inset: auto 0 calc(-1 * var(--indice-hueco)) 0;
    text-align: right;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .folio span {
    font-weight: var(--weight-bold);
  }

  /* El índice es lo único que dice cuántos hay y por dónde vas. Sin él, y sin
     botones, la baraja no se anuncia. */
  .indice {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 4;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .indice span {
    font-weight: var(--weight-bold);
    opacity: 1;
  }

  .mandos {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
  }

  /* ——— El botón de vista ———
     Al lado del índice y con su misma opacidad: es parte de la línea, no un
     mando más. Se aclara entera al pasar por encima. */
  .vista {
    all: unset;
    display: inline-flex;
    vertical-align: -0.15em;
    margin-left: 0.8em;
    padding: 0.2em;
    border-radius: 4px;
    cursor: var(--cursor);
  }

  .vista svg {
    width: 1.05em;
    height: 1.05em;
  }

  .vista:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 2px;
  }

  .indice:has(.vista:hover, .vista:focus-visible) {
    opacity: 1;
  }

  .vista .icono-baraja,
  .vista[aria-pressed='true'] .icono-grilla {
    display: none;
  }

  .vista[aria-pressed='true'] .icono-baraja {
    display: block;
  }

  /* ——— La grilla ———
     Ocupa el escenario menos la línea del índice y, si no cabe, se desplaza
     por dentro: la página sigue sin scroll. Al abrirla la baraja se desvanece
     con su mismo paso. */
  .grilla {
    position: absolute;
    inset: 0 0 var(--indice-hueco) 0;
    z-index: 6;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--baraja-paso) var(--ease),
      visibility var(--baraja-paso) var(--ease);
  }

  .escenario[data-vista='grilla'] .grilla {
    opacity: 1;
    visibility: visible;
  }

  .escenario[data-vista='grilla'] :is(.proyecto, .capa-pestana, .sena) {
    opacity: 0;
    pointer-events: none;
  }

  .grilla ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.375rem, 0.6vw, 0.625rem);
    align-content: center;
    min-height: 100%;
    padding-block: clamp(1rem, 3vh, 2rem);
  }

  .miniatura {
    all: unset;
    display: block;
    width: 100%;
    cursor: var(--cursor);
  }

  /* El mismo papel gris del recuadro, a sangre: aquí se reconoce el proyecto,
     no se mira la pieza. */
  .mini-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface-subtle);
  }

  .mini-media :is(img, video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      scale var(--transition-normal),
      opacity var(--transition-normal);
  }

  .miniatura:hover .mini-media :is(img, video) {
    scale: 1.03;
  }

  .miniatura:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 4px;
    border-radius: 8px;
  }

  @media (max-width: 48rem) {
    .grilla ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
    }
  }

  /* ——— El visor ———
     La pieza a pantalla casi completa sobre un fondo oscuro. Nada de recuadro
     ni bisel aquí: eso era el paspartú del listado, y ampliar es justo quitarlo
     de en medio. */
  .visor {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    transition:
      opacity var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  .visor[open] {
    opacity: 1;
  }

  /* Estado de partida del fundido: sin esto el visor aparece de golpe. */
  @starting-style {
    .visor[open] {
      opacity: 0;
    }
  }

  .visor::backdrop {
    background: rgb(0 8 40 / 0);
    transition:
      background var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  .visor[open]::backdrop {
    background: rgb(0 8 40 / 0.88);
  }

  @starting-style {
    .visor[open]::backdrop {
      background: rgb(0 8 40 / 0);
    }
  }

  .visor img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  .cerrar {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1rem, 2.5vw, 2rem);
    display: flex;
    padding: 0.6rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--white);
    cursor: var(--cursor);
    opacity: 0.7;
    transition: opacity var(--transition-normal);
  }

  .cerrar:hover {
    opacity: 1;
  }

  .cerrar svg {
    width: 22px;
    height: 22px;
  }

  .paginas {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 2.5vw, 2rem);
    translate: -50% 0;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .paginas span {
    font-weight: var(--weight-bold);
  }

  /* Con una sola lámina no hay nada que numerar. */
  .visor[data-unica] .paginas {
    display: none;
  }

  /* ——— La seña ——— */
  /* Vive en el margen derecho, centrada con la lámina: fuera de la caja de
     texto, en el canal que queda libre. El cuarto del ancho sobrante es
     justo el centro de ese canal. */
  .sena {
    position: absolute;
    top: 50%;
    right: calc((100% - min(64%, 1280px)) / 4);
    z-index: 4;
    translate: 50% -50%;
  }

  /* Un ratón dibujado con una sola línea. Las medidas son las de un ratón de
     verdad en pequeño: alto el doble que ancho, esquinas muy redondeadas. */
  .raton {
    display: flex;
    justify-content: center;
    width: 22px;
    height: 34px;
    padding-top: 6px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 11px;
  }

  .raton img {
    width: 9px;
    height: 9px;
    animation: baja 1.9s var(--ease) infinite;
  }

  /* Baja, se desvanece y vuelve a empezar: el gesto que hay que hacer. */
  @keyframes baja {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    22% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(11px);
      opacity: 0;
    }
  }

  /* Con movimiento reducido la rueda se queda quieta y a la vista. La regla
     global acorta las animaciones a 0,01ms y aquí la dejaría invisible. */
  @media (prefers-reduced-motion: reduce) {
    .raton img {
      animation: none;
      opacity: 1;
    }
  }

  /* La columna de texto sale de los mockups: 27% contra 66%. Por debajo de este
     ancho se queda en menos de 180px —cuatro palabras por línea— y deja de
     leerse, así que ahí se apila. */
  @media (max-width: 64rem) {
    /* Apilado el recuadro va arriba del todo, así que la pestaña no puede ir a
       su altura —se le montaría encima—. Vuelve a su franja propia y las cartas
       arrancan por debajo. */
    .pestana {
      top: 0;
    }

    .ficha {
      padding-top: 0;
    }

    .proyecto {
      inset: calc(var(--pestana-alto) + var(--pestana-aire)) 0 var(--indice-hueco) 0;
      grid-template-columns: 1fr;
      /* La lámina toma lo que sobre y la ficha lo que necesite. `minmax(0, 1fr)`
         y no `1fr` a secas: sin el mínimo en cero, la fila se niega a encoger
         por debajo del contenido y la baraja acaba desbordando la pantalla. */
      grid-template-rows: auto minmax(0, 1fr);
      gap: var(--spacing-05);
      align-content: stretch;
    }

    /* La ficha va justo debajo de la pestaña y la lámina después. Con la lámina
       en medio, una ficha larga la encogía y la subía, y el texto quedaba a una
       distancia distinta de su logo en cada proyecto. Así la distancia es
       siempre la misma y lo que cambia es el alto de la lámina. */
    .ficha {
      order: 1;
    }

    /* Aquí la altura no puede salir de la proporción: la impone el sitio que
       queda una vez puesta la ficha. */
    .media {
      order: 2;
      aspect-ratio: auto;
      min-height: 0;
      height: 100%;
    }

    .proyecto[data-estado='siguiente'],
    .proyecto[data-estado='fondo'] {
      translate: 0 3%;
    }
  }

  /* La seña dibuja un ratón: donde no hay ratón, sobra. El gesto ahí es
     deslizar, y eso ya lo sabe cualquiera que haya usado un teléfono. */
  @media (hover: none) {
    .sena {
      display: none;
    }
  }

  /* ——— Pantallas bajas ———
     Un portátil de 600px de alto deja unos 300 para el proyecto, y la ficha
     larga pedía 356: se desbordaba por arriba, por debajo de la pestaña. Aquí
     el texto se aprieta en vez de invadir. Va por alto de ventana y no por
     ancho, que es lo que de verdad escasea. */
  @media (max-height: 46rem) {
    .escenario {
      --pestana-aire: 0.9rem;
      --indice-hueco: 2rem;
    }

    .descripcion,
    .meta,
    .enlace {
      margin-top: 0.9em;
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    /* Último cerrojo: si aun así no cupiera —una ficha larguísima en una
       ventana muy baja—, la ficha se recorta antes que montarse sobre la
       pestaña o sobre el índice. */
    .ficha {
      min-height: 0;
      overflow: hidden;
    }
  }

  /* En dos columnas y con poco alto, la que desborda es la lámina: su 16/10
     pedía 338px donde había 315. Aquí la fila manda sobre la proporción, igual
     que en vertical. Va a partir de 64rem para no pisar el bloque de apilado,
     que ya resuelve lo suyo con sus propias filas. */
  @media (min-width: 64.0625rem) and (max-height: 46rem) {
    .proyecto {
      grid-template-rows: minmax(0, 1fr);
      align-content: stretch;
    }

    .media {
      aspect-ratio: auto;
      min-height: 0;
      height: 100%;
    }

    /* La ficha no se estira y no se centra: se queda colgando de la pestaña,
       a la misma distancia del logo en todos los proyectos. */
    .ficha {
      align-self: start;
    }
  }
</style>

<script>
  // La baraja: una sola pila, un solo índice. El guion no anima nada —de eso se
  // encargan las transiciones del CSS—, solo dice qué capa está en cada estado.
  if (!(window as any).__barajaMontada) {
    (window as any).__barajaMontada = true;

    const PASO = 620; // ms que dura el relevo; debe casar con --baraja-paso.
    const UMBRAL_RUEDA = 28; // Cuánto hay que girar para que cuente como un paso.
    const UMBRAL_DEDO = 40;

    let activo = 0;
    let bloqueado = false;
    let acumulado = 0;
    let ultimoGiro = 0;

    const capas = () => [...document.querySelectorAll<HTMLElement>('[data-proyecto]')];

    const pintar = () => {
      const lista = capas();
      lista.forEach((capa, indice) => {
        const distancia = indice - activo;
        const estado =
          distancia < 0
            ? 'pasado'
            : distancia === 0
              ? 'activo'
              : distancia === 1
                ? 'siguiente'
                : distancia === 2
                  ? 'fondo'
                  : 'oculto';
        capa.dataset.estado = estado;
        // Lo que no se ve tampoco se lee ni se tabula.
        capa.toggleAttribute('inert', estado !== 'activo');

        // Una grabación solo corre arriba: las de las capas apagadas no gastan
        // ni batería ni datos. Con movimiento reducido no arranca sola.
        capa.querySelectorAll('video').forEach((video) => {
          if (estado === 'activo' && !sinMovimiento()) {
            if (video.dataset.src) {
              video.src = video.dataset.src;
              video.removeAttribute('data-src');
            }
            // Al llegar sin recarga, Astro arma la página en un documento aparte
            // y la grabación que ya traía `src` intenta cargar ahí, falla y no
            // vuelve a intentarlo al entrar en la página. Se le pide de nuevo.
            if (video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) video.load();
            video.preload = 'auto';
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      });

      const marcador = document.querySelector('[data-indice]');
      if (marcador) marcador.textContent = String(activo + 1);

      // El proyecto que llega arriba empieza por su primera hoja. Las demás
      // capas se quedan como estaban: van apagadas, nadie ve en qué hoja quedan.
      const capa = lista[activo];
      if (capa) mostrarHoja(capa, 0);
      programarPase();
    };

    // ——— El pase de hojas ———
    // Una hoja cada `--pase-ritmo`, solo en el proyecto de arriba. Las hojas se
    // piden de una en una, la que se ve y la que viene: un documento de cien
    // páginas no se descarga por si acaso. Se piden en firme porque la carga
    // diferida no sirve aquí: todas las capas están dentro del viewport aunque
    // estén apagadas. El orden importa: primero se levanta el diferido, después
    // se pone la dirección.
    let pase: number | undefined;

    const cargar = (hoja?: Element) => {
      hoja?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.loading = 'eager';
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
      });
    };

    const mostrarHoja = (capa: HTMLElement, n: number) => {
      const hojas = [...capa.querySelectorAll('[data-hoja]')];
      if (!hojas.length) return;
      hojas.forEach((hoja, i) => hoja.toggleAttribute('data-vista', i === n));
      cargar(hojas[n]);
      cargar(hojas[(n + 1) % hojas.length]);
      capa.dataset.hojaVista = String(n);

      const folio = capa.querySelector('[data-folio]');
      if (folio) folio.textContent = String(n + 1).padStart(2, '0');
    };

    const ritmo = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--pase-ritmo')) *
        1000 || 3200;

    // Con movimiento reducido no hay pase: la primera hoja se queda quieta y
    // el resto se ve en el visor, pasándolas a mano.
    const sinMovimiento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    const programarPase = () => {
      clearTimeout(pase);
      const capa = capas()[activo];
      const total = capa?.querySelectorAll('[data-hoja]').length ?? 0;
      if (!capa || total < 2 || sinMovimiento()) return;

      pase = window.setTimeout(() => {
        // Con el visor abierto el pase espera: lo de detrás está tapado.
        if (!visorAbierto() && capa.dataset.estado === 'activo') {
          mostrarHoja(capa, (Number(capa.dataset.hojaVista ?? 0) + 1) % total);
        }
        programarPase();
      }, ritmo());
    };

    // El logo del cliente. La pestaña no se mueve; lo que se releva es lo de
    // dentro: el que estaba se va por abajo y el nuevo cae desde arriba.
    //
    // El que llega puede venir de haber salido por abajo en otra vuelta, así
    // que primero se le devuelve arriba sin transición —de un salto, que nadie
    // ve— y solo entonces se le deja caer. Sin ese paso subiría desde abajo.
    const relevarLogo = (indice: number) => {
      const pestana = document.querySelector<HTMLElement>('[data-pestana]');
      const logos = [...document.querySelectorAll<HTMLElement>('[data-pestana] [data-logo]')];
      // Un proyecto sin logo no deja una pestaña blanca vacía: se apaga.
      pestana?.toggleAttribute(
        'data-vacia',
        !logos.some((logo) => logo.dataset.logo === String(indice)),
      );

      logos.forEach((logo) => {
        if (logo.dataset.logo === String(indice)) {
          // La pestaña se estira o se encoge hasta el ancho del logo que llega.
          pestana?.style.setProperty('--pestana-ancho', `${logo.dataset.pestanaAncho}px`);
          if (logo.dataset.sitio !== 'arriba') {
            logo.style.transition = 'none';
            logo.dataset.sitio = 'arriba';
            void logo.offsetWidth; // Fuerza el salto antes de volver a animar.
            logo.style.transition = '';
          }
          logo.dataset.sitio = 'centro';
        } else if (logo.dataset.sitio === 'centro') {
          logo.dataset.sitio = 'abajo';
        }
      });
    };

    const ir = (destino: number) => {
      const total = capas().length;
      // Sin bucle: la baraja tiene principio y final, como un mazo en la mano.
      const siguiente = Math.min(Math.max(destino, 0), total - 1);
      if (siguiente === activo || bloqueado) return;

      activo = siguiente;
      pintar();
      relevarLogo(activo);

      // Un gesto, un paso: sin este cerrojo un golpe de trackpad se lleva media
      // baraja por delante.
      bloqueado = true;
      setTimeout(() => {
        bloqueado = false;
      }, PASO * 0.72);
    };

    const hayBaraja = () => !!document.querySelector('[data-baraja]');

    // ——— La grilla ———
    // Mientras está abierta, la baraja no se mueve: la rueda desplaza la grilla
    // y las teclas recorren las miniaturas. Pulsar una cierra la grilla y deja
    // la baraja en ese proyecto.
    const grilla = () => document.querySelector<HTMLElement>('[data-grilla]');
    const enGrilla = () => escenario()?.dataset.vista === 'grilla';
    let observador: IntersectionObserver | undefined;

    const abrirGrilla = () => {
      const caja = escenario();
      const lista = grilla();
      if (!caja || !lista) return;

      lista.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-src]').forEach((m) => {
        m.src = m.dataset.src!;
        m.removeAttribute('data-src');
      });

      // Las miniaturas corren solo mientras se ven: son catorce videos, y en
      // el teléfono la mayoría queda fuera de la pantalla.
      if (!sinMovimiento()) {
        observador?.disconnect();
        observador = new IntersectionObserver(
          (entradas) =>
            entradas.forEach(({ target, isIntersecting }) => {
              const video = target as HTMLVideoElement;
              if (isIntersecting) video.play().catch(() => {});
              else video.pause();
            }),
          { root: lista, threshold: 0.15 },
        );
        lista.querySelectorAll('video').forEach((video) => observador!.observe(video));
      }

      clearTimeout(pase);
      capas().forEach((capa) => {
        capa.inert = true;
        capa.querySelectorAll('video').forEach((video) => video.pause());
      });

      caja.dataset.vista = 'grilla';
      lista.inert = false;
      const boton = document.querySelector('[data-vista-cambiar]');
      boton?.setAttribute('aria-pressed', 'true');
      boton?.setAttribute('aria-label', 'Volver a la vista de proyecto');

      // Se abre mostrando el proyecto en que se estaba. Se mueve solo la grilla:
      // `scrollIntoView` correría también la página, que no tiene scroll pero
      // igual se deja empujar, y se llevaría el encabezado.
      const actual = lista.querySelector<HTMLElement>(`[data-ir="${activo}"]`);
      if (actual) {
        lista.scrollTop = actual.offsetTop - (lista.clientHeight - actual.offsetHeight) / 2;
      }
    };

    const cerrarGrilla = (destino = activo) => {
      const caja = escenario();
      const lista = grilla();
      if (!caja || !lista) return;

      delete caja.dataset.vista;
      lista.inert = true;
      observador?.disconnect();
      lista.querySelectorAll('video').forEach((video) => video.pause());
      const boton = document.querySelector('[data-vista-cambiar]');
      boton?.setAttribute('aria-pressed', 'false');
      boton?.setAttribute('aria-label', 'Ver todos los proyectos');

      // Un salto, no un paso: va directo al elegido, sin el cerrojo del gesto.
      const cambia = destino !== activo;
      activo = destino;
      pintar();
      if (cambia) relevarLogo(activo);
    };

    // ——— El visor ———
    // Mientras está abierto, la baraja no se mueve: ni rueda, ni teclas, ni
    // arrastre. Se está mirando una pieza, no recorriendo el portafolio.
    const visor = () => document.querySelector<HTMLDialogElement>('[data-visor]');
    const visorAbierto = () => !!visor()?.open;

    let laminasDelVisor: string[] = [];
    let laminaDelVisor = 0;

    const pintarVisor = () => {
      const caja = visor();
      const img = caja?.querySelector<HTMLImageElement>('[data-visor-img]');
      if (!caja || !img) return;

      img.src = laminasDelVisor[laminaDelVisor];
      caja.querySelector('[data-visor-indice]')!.textContent = String(laminaDelVisor + 1);
      caja.querySelector('[data-visor-total]')!.textContent = String(laminasDelVisor.length);
      caja.toggleAttribute('data-unica', laminasDelVisor.length < 2);
    };

    // `desde` es la lámina que se pulsó. El pase está en marcha, así que abrir
    // siempre por la primera sería abrir otra distinta de la que se señaló. Sin
    // lámina pulsada —desde el teclado— se abre por la hoja que está a la vista.
    const abrirVisor = (desde?: HTMLImageElement | null) => {
      const caja = visor();
      const carta = document.querySelector('[data-proyecto][data-estado="activo"]');
      const laminas = [...(carta?.querySelectorAll<HTMLImageElement>('img[data-lamina]') ?? [])];
      desde ??= carta?.querySelector<HTMLImageElement>('[data-hoja][data-vista] img[data-lamina]');
      if (!caja || !laminas.length) return;

      laminasDelVisor = laminas.map((l) => l.src || l.dataset.src || '');
      laminaDelVisor = Math.max(0, Number(desde?.dataset.lamina ?? 0));

      const img = caja.querySelector<HTMLImageElement>('[data-visor-img]');
      if (img) img.alt = laminas[0].alt || carta?.querySelector('h2')?.textContent || '';

      pintarVisor();
      caja.showModal();
      // Marca en <html> que hay una pieza ampliada encima de todo.
      document.documentElement.dataset.visorAbierto = 'si';
    };

    const pasarEnElVisor = (paso: number) => {
      if (laminasDelVisor.length < 2) return;
      laminaDelVisor =
        (laminaDelVisor + paso + laminasDelVisor.length) % laminasDelVisor.length;
      pintarVisor();
    };

    document.addEventListener(
      'wheel',
      (evento) => {
        if (!hayBaraja() || visorAbierto() || enGrilla()) return;
        evento.preventDefault(); // La página no tiene scroll: la rueda es para esto.

        // El trackpad manda decenas de eventos por gesto y con inercia. Se suman
        // hasta pasar el umbral y se reinicia la cuenta si el dedo se levanta.
        const ahora = performance.now();
        if (ahora - ultimoGiro > 180) acumulado = 0;
        ultimoGiro = ahora;

        if (bloqueado) return;
        acumulado += evento.deltaY;

        if (Math.abs(acumulado) < UMBRAL_RUEDA) return;
        ir(activo + Math.sign(acumulado));
        acumulado = 0;
      },
      { passive: false },
    );

    document.addEventListener('keydown', (evento) => {
      if (!hayBaraja()) return;

      // Con el visor abierto las flechas pasan páginas de la pieza, no
      // proyectos.
      if (visorAbierto()) {
        if (evento.key === 'Escape') {
          evento.preventDefault();
          cerrarVisor();
        } else if (evento.key === 'ArrowRight' || evento.key === 'ArrowDown') {
          evento.preventDefault();
          pasarEnElVisor(1);
        } else if (evento.key === 'ArrowLeft' || evento.key === 'ArrowUp') {
          evento.preventDefault();
          pasarEnElVisor(-1);
        }
        return;
      }

      // En la grilla las teclas son las de siempre —tabular, Enter, espacio—;
      // solo Esc se aparta, y vuelve a la baraja sin cambiar de proyecto.
      if (enGrilla()) {
        if (evento.key === 'Escape') {
          evento.preventDefault();
          cerrarGrilla();
        }
        return;
      }

      const avanza = ['ArrowDown', 'ArrowRight', 'PageDown', ' '];
      const retrocede = ['ArrowUp', 'ArrowLeft', 'PageUp'];

      if (avanza.includes(evento.key)) {
        evento.preventDefault();
        ir(activo + 1);
      } else if (retrocede.includes(evento.key)) {
        evento.preventDefault();
        ir(activo - 1);
      } else if (evento.key === 'Home') {
        evento.preventDefault();
        ir(0);
      } else if (evento.key === 'End') {
        evento.preventDefault();
        ir(capas().length - 1);
      }
    });

    document.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;
      const caja = visor();

      if (objetivo.closest('[data-visor-cerrar]')) return cerrarVisor();
      // Clic en el fondo del visor —fuera de la pieza— también cierra.
      if (caja?.open && objetivo === caja) return cerrarVisor();

      if (objetivo.closest('[data-vista-cambiar]')) return enGrilla() ? cerrarGrilla() : abrirGrilla();
      const miniatura = objetivo.closest<HTMLElement>('[data-ir]');
      if (miniatura) return cerrarGrilla(Number(miniatura.dataset.ir));

      if (objetivo.closest('[data-ampliar]')) return abrirVisor(null);
      if (objetivo.closest('[data-siguiente]')) ir(activo + 1);
      if (objetivo.closest('[data-anterior]')) ir(activo - 1);
    });

    // El `close` del <dialog> no burbujea y tampoco se deja capturar desde
    // `document`: hay que engancharlo al propio elemento, y volver a hacerlo
    // cada vez que Astro reemplaza el <body>.
    // Todo cierre pasa por aquí. El evento `close` del <dialog> se despacha en
    // una tarea aparte y hay entornos donde no llega; colgar de él la limpieza
    // dejaba la marca puesta para siempre. Se mantiene enganchado igualmente,
    // por si el cierre viene del navegador y no de nosotros, y como la función
    // tiene nombre, engancharla dos veces no la ejecuta dos veces.
    const alCerrarVisor = () => {
      delete document.documentElement.dataset.visorAbierto;
    };

    const cerrarVisor = () => {
      visor()?.close();
      alCerrarVisor();
    };

    const escucharElCierre = () => {
      visor()?.addEventListener('close', alCerrarVisor);
    };

    // ——— Arrastre ———
    // Un solo camino para el ratón, el dedo y el lápiz. La baraja acompaña al
    // puntero con resistencia —se mueve bastante menos de lo que se tira— y al
    // soltar decide: si se pasó del umbral, avanza; si no, vuelve a su sitio.
    const RESISTENCIA = 0.32;
    const TOPE_ARRASTRE = 90; // px que puede correrse la baraja como mucho.

    let partida: number | null = null;
    let recorrido = 0;
    let origen: HTMLElement | null = null;

    const escenario = () => document.querySelector<HTMLElement>('[data-baraja]');

    document.addEventListener('pointerdown', (evento) => {
      const caja = escenario();
      if (!caja || visorAbierto() || enGrilla()) return;
      if (!(evento.target as HTMLElement).closest('[data-baraja]')) return;
      // Los enlaces y los botones se pulsan, no se arrastran.
      if ((evento.target as HTMLElement).closest('a, button')) return;

      partida = evento.clientY;
      recorrido = 0;
      origen = evento.target as HTMLElement;
      caja.setAttribute('data-arrastrando', '');
      caja.setPointerCapture?.(evento.pointerId);
      // Sin esto, tirar del texto lo selecciona en vez de mover la baraja.
      evento.preventDefault();
    });

    document.addEventListener('pointermove', (evento) => {
      const caja = escenario();
      if (partida === null || !caja) return;

      recorrido = evento.clientY - partida;
      const corrido = Math.max(
        -TOPE_ARRASTRE,
        Math.min(recorrido * RESISTENCIA, TOPE_ARRASTRE),
      );
      caja.style.setProperty('--arrastre', `${corrido}px`);
    });

    const soltar = () => {
      const caja = escenario();
      if (partida === null || !caja) return;

      partida = null;
      caja.removeAttribute('data-arrastrando');
      caja.style.setProperty('--arrastre', '0px');

      // Un toque sin recorrido sobre la lámina no es un arrastre: es un clic, y
      // amplía la pieza. Se resuelve aquí y no en el evento `click` porque el
      // `preventDefault` del arrastre se lo come.
      if (Math.abs(recorrido) < 5 && origen?.closest('.pantalla')) {
        const pulsada = origen.closest('img') as HTMLImageElement | null;
        origen = null;
        recorrido = 0;
        return abrirVisor(pulsada);
      }

      // Se tira hacia arriba para avanzar, como al empujar una carta fuera.
      if (Math.abs(recorrido) >= UMBRAL_DEDO) ir(activo - Math.sign(recorrido));
      recorrido = 0;
      origen = null;
    };

    document.addEventListener('pointerup', soltar);
    document.addEventListener('pointercancel', soltar);

    // Al entrar en la página —o al volver a ella sin recarga— la baraja empieza
    // de nuevo desde arriba: el <body> es otro y las capas también.
    // La pestaña va a ras del borde superior del recuadro. Ese borde sale de la
    // retícula —columnas, canal, proporción—, así que se mide en vez de
    // escribirse: una fórmula en CSS habría que rehacerla en cada punto de
    // corte. Se mide una sola vez y sirve para los diez, porque todos los
    // recuadros son del mismo tamaño; así la pestaña no se mueve al pasar de
    // proyecto, que es justo lo que se le pide.
    const colocarPestana = () => {
      const escenario = document.querySelector<HTMLElement>('[data-baraja]');
      const recuadro = escenario?.querySelector('.media');
      if (!escenario || !recuadro) return;

      // Dos pasadas, y hacen falta las dos. Primero se mide el alto del
      // recuadro con la fila suelta —ese alto solo depende de su ancho y de su
      // proporción, así que sale bien—. Al fijarlo, la fila cambia de tamaño y
      // el borde superior se mueve: por eso el segundo dato se lee después, ya
      // con la fila puesta. Midiendo todo de una vez, la pestaña quedaba
      // desalineada justo en los proyectos de ficha larga.
      escenario.style.removeProperty('--fila-alto');
      escenario.style.removeProperty('--pestana-y');

      const alto = Math.round(recuadro.getBoundingClientRect().height);
      escenario.style.setProperty('--fila-alto', `${alto}px`);

      const borde =
        recuadro.getBoundingClientRect().top - escenario.getBoundingClientRect().top;
      escenario.style.setProperty('--pestana-y', `${Math.round(borde)}px`);
    };

    window.addEventListener('resize', colocarPestana);

    const arrancar = () => {
      activo = 0;
      acumulado = 0;
      bloqueado = false;
      if (!hayBaraja()) return;
      pintar();
      relevarLogo(0);
      colocarPestana();
      escucharElCierre();
    };

    document.addEventListener('astro:page-load', arrancar);

    // Y también ahora mismo: en la primera carga, el router de Astro puede
    // haber lanzado ya su evento antes de que este módulo llegara a existir.
    arrancar();
  }
</script>
