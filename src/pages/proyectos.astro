---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<Base
  title="Proyectos"
  description="Proyectos del estudio: identidad, publicaciones editoriales, plataformas digitales y otros productos de comunicación."
  accion="Volver al inicio"
  accionHref={import.meta.env.BASE_URL}
>
  <h1 class="visually-hidden">Proyectos</h1>

  <div class="container listado">
    {
      proyectos.map((proyecto, indice) => {
        const { titulo, descripcion, tipo, rol, anio, enlace, enlaceTexto, media, mediaAlt } =
          proyecto.data;

        return (
          <article class="fila">
            {/* Los corchetes son parte de la composición, no una marca de hueco
                por rellenar: van en la plantilla y no en el contenido, para que
                los .md queden limpios. El título y el enlace van sin ellos. */}
            <div class="ficha">
              <h2>{titulo}</h2>
              <p class="descripcion">[{descripcion}]</p>

              <dl class="meta">
                <dt class="visually-hidden">Tipo</dt>
                <dd>[{tipo}]</dd>
                <dt class="visually-hidden">Rol</dt>
                <dd>[{rol}]</dd>
                <dt class="visually-hidden">Año</dt>
                <dd>[{anio}]</dd>
              </dl>

              {enlace && (
                <a class="enlace" href={enlace} target="_blank" rel="noopener">
                  {enlaceTexto ?? enlace}
                  <svg
                    class="flecha"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.5 11.5 11.5 4.5" />
                    <path d="M5.5 4.5h6v6" />
                  </svg>
                  <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                </a>
              )}
            </div>

            {/* Sin imagen se muestra el marcador blanco de los mockups.
                La pieza va contenida, no recortada: son grabaciones de pantalla
                mucho más apaisadas que el recuadro, y recortarlas se comería la
                interfaz por los costados. */}
            <div class="media">
              {media && (
                <span class="pantalla">
                  <img
                    src={`${base}media/${media}`}
                    alt={mediaAlt ?? ''}
                    loading={indice === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Base>

<style>
  .listado {
    padding-block: var(--spacing-07) var(--spacing-12);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  /* Ficha de texto estrecha a la izquierda, media ancha a la derecha.
     Proporción tomada de los mockups: ~27% / ~66%, con un canal entre medio. */
  .fila {
    display: grid;
    grid-template-columns: minmax(0, 27fr) minmax(0, 66fr);
    gap: 7%;
    align-items: start;
  }

  h2 {
    font-size: var(--text-body-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .descripcion {
    margin-top: 1.8em;
  }

  .meta {
    margin-top: 1.8em;
  }

  .descripcion,
  .meta {
    font-size: var(--text-body);
    line-height: 1.95;
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.2em;
    font-weight: var(--weight-bold);
    line-height: 1.95;
  }

  .flecha {
    width: 0.9em;
    height: 0.9em;
    flex: none;
  }

  /* ⚠ Radio grande: se aparta del sistema de diseño, que pide cards sin
     redondeo. Los mockups lo piden así. */
  .media {
    aspect-ratio: 16 / 10;
    /* Gris muy claro en vez de blanco puro. Además de bajar el contraste
       contra el azul, es lo que deja sitio para la luz del canto inferior:
       sobre blanco no se puede iluminar nada. */
    background: var(--surface-subtle);
    border-radius: 8px;
    /* La pieza no toca el borde: el recuadro actúa de paspartú. En porcentaje
       para que el aire crezca con él. */
    padding: clamp(8px, 1.8%, 20px);
    display: grid;
    place-items: center;
    /* Biselado hundido: sombra difusa arriba y luz abajo, al revés que un canto
       realzado. Lee como un rebaje tallado en la página. Solo bordes internos,
       sin sombra proyectada, para no sumar una segunda elevación a la que ya
       tiene la pantalla dentro. */
    box-shadow:
      inset 0 3px 5px -2px rgb(0 0 0 / 0.22),
      inset 0 -1px 0 rgb(255 255 255 / 0.9),
      inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  /* La pantalla se ajusta al tamaño real de la pieza en vez de estirarse a la
     caja. Es lo que permite que el bisel y la sombra abracen la imagen y no
     las bandas vacías que deja una grabación más apaisada que el recuadro. */
  .pantalla {
    display: flex;
    max-width: 100%;
    max-height: 100%;
    border-radius: 5px;
    overflow: hidden;
    /* ⚠ Sombra: el sistema de diseño es plano y la prohíbe. Aquí levanta la
       grabación del papel para que se lea como una pantalla. Va en capas —una
       línea de contacto, un apoyo corto y una caída larga y difusa— porque una
       sombra sola se ve artificial. */
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.07),
      0 1px 2px rgb(0 0 0 / 0.06),
      0 6px 16px rgb(0 0 0 / 0.1),
      0 20px 40px rgb(0 0 0 / 0.07);
  }

  .pantalla img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  @media (max-width: 60rem) {
    .fila {
      grid-template-columns: 1fr;
      gap: var(--spacing-07);
    }

    .listado {
      gap: var(--spacing-10);
      padding-block: var(--spacing-08) var(--spacing-10);
    }

    .media {
      border-radius: 6px;
    }
  }
</style>
