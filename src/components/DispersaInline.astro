---
// La frase del manifiesto que abre la lista de lo que una organización ya
// tiene. No son documentos ni quejas, son las materias en las que se reparte su
// propio trabajo: lo que genera para funcionar y nunca para mostrarse.
//
// La lista no se ordena ni se encuadra: se esparce por toda la pestaña y cada
// palabra deriva por su cuenta, en su dirección y a su ritmo. La frase dice
// «información dispersa» y la lista lo enseña en vez de contarlo.
const materias = [
  'proyectos',
  'ventas',
  'servicios',
  'operaciones',
  'campañas',
  'programas',
  'conocimiento técnico',
  'métodos',
  'procesos',
  'protocolos',
  'manuales',
  'patentes',
  'cifras',
  'resultados',
  'indicadores',
  'memorias anuales',
  'identidad gráfica',
  'clientes',
  'socios',
  'proveedores',
  'alianzas',
  'convenios',
  'trayectoria',
  'hitos',
  'aprendizajes',
];

// Azar con semilla fija: el desorden se decide en el build y sale idéntico en
// cada compilación. Con Math.random() cada despliegue movería las palabras de
// sitio sin que nadie lo hubiera pedido, y el diff sería ruido puro.
const crearAzar = (semilla: number) => () => {
  semilla = (semilla + 0x6d2b79f5) | 0;
  let t = Math.imul(semilla ^ (semilla >>> 15), 1 | semilla);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const azar = crearAzar(20260819);

const redondear = (n: number) => Math.round(n * 100) / 100;

// El reparto sale de una rejilla con la celda desordenada, no de posiciones
// sueltas al azar: al azar puro las palabras se apelmazan en un rincón y dejan
// media pestaña vacía. La rejilla garantiza que ocupen todo; el temblor dentro
// de cada celda quita la cuadrícula de la vista.
const columnas = 5;
const filas = Math.ceil(materias.length / columnas);

const dispersas = materias.map((materia, i) => {
  const x = (((i % columnas) + 0.5) / columnas) * 100 + (azar() - 0.5) * 14;
  const y = ((Math.floor(i / columnas) + 0.5) / filas) * 100 + (azar() - 0.5) * 14;

  // Las direcciones se reparten en abanico por el círculo completo, con un
  // temblor que rompe la regularidad. Al azar puro se apelotonan: en una tirada
  // salieron once de veinticinco hacia el mismo rincón, y once palabras yéndose
  // juntas leen como una corriente, no como un desorden.
  const angulo = ((i / materias.length) + (azar() - 0.5) / materias.length) * Math.PI * 2;
  const alcance = 2.5 + azar() * 4.5;

  // El margen se guarda contra la deriva, no contra el reparto: una palabra
  // colocada justo en el borde se sale al derivar y aparece cortada por la
  // mitad. El tope deja sitio para el viaje entero.
  return {
    materia,
    x: redondear(Math.min(91, Math.max(9, x))),
    y: redondear(Math.min(89, Math.max(11, y))),
    dx: redondear(Math.cos(angulo) * alcance),
    dy: redondear(Math.sin(angulo) * alcance),
    // Cada palabra tarda lo suyo y arranca a destiempo (retraso negativo): con
    // el mismo ritmo para todas el conjunto late a la vez y parece un latido
    // ordenado, justo lo contrario de lo que la frase dice.
    factor: redondear(0.7 + azar() * 1.3),
    desfase: redondear(-azar() * 2),
    giro: redondear((azar() - 0.5) * 12),
  };
});
---

<span class="dispersa" data-dispersa>
  <button type="button" aria-expanded="false" aria-controls="lista-dispersa">
    <strong><slot /></strong>
  </button>

  {/* El paso previo: al pasar por encima, la frase dice que hay algo que abrir
      antes de abrirlo. Decorativa para lector de pantalla, que ya recibe lo
      mismo por el `aria-expanded` del botón. */}
  <span class="pista" aria-hidden="true">¿Qué tipo de información?</span>

  {/* Decorativa: la lista ilustra la frase, no añade información que haya que
      leer con lector de pantalla mientras deriva. */}
  <span class="campo" id="lista-dispersa" aria-hidden="true">
    {
      dispersas.map((d) => (
        <span
          class="materia"
          style={`--x:${d.x}%;--y:${d.y}%;--dx:${d.dx}vmin;--dy:${d.dy}vmin;--factor:${d.factor};--desfase:${d.desfase};--giro:${d.giro}deg`}
        >
          {d.materia}
        </span>
      ))
    }
  </span>
</span>

<style>
  .dispersa {
    position: relative;
    display: inline;
  }

  /* El botón no debe leerse como botón, sino como la misma frase del texto con
     el subrayado que el sitio ya usa para decir que algo hace algo. */
  .dispersa button {
    all: unset;
    cursor: var(--cursor);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: rgb(255 255 255 / 0.55);
    text-underline-offset: 0.22em;
    transition:
      text-decoration-color var(--transition-normal),
      text-underline-offset var(--transition-normal);
  }

  .dispersa button:hover,
  .dispersa[data-abierto] button {
    text-decoration-color: var(--white);
    text-underline-offset: 0.34em;
  }

  .dispersa button:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 4px;
  }

  .dispersa strong {
    font-weight: var(--weight-bold);
  }

  /* Mismo recuadro que el panel del equipo y la tira de logos, en pequeño: es
     una pista, no un panel. Cuelga de la frase, no de la pestaña, porque habla
     de la frase. */
  .pista {
    position: absolute;
    top: calc(100% + 0.6em);
    left: 0;
    z-index: 6;

    padding: 0.4em 0.75em;

    background: var(--white);
    color: var(--color-brand);
    border-radius: 8px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.07),
      0 1px 2px rgb(0 0 0 / 0.06),
      0 6px 16px rgb(0 0 0 / 0.1),
      0 20px 40px rgb(0 0 0 / 0.07);

    /* Vive dentro del <h1>: hay que devolverle una escala de lectura. */
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: normal;
    text-align: left;
    white-space: nowrap;

    /* No debe interceptar el puntero: se abre justo debajo de la frase, y si
       captura el hover se tapa a sí misma y parpadea. */
    pointer-events: none;

    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  /* Ya no es un recuadro colgado de la frase: es la pestaña entera. Sin fondo
     blanco ni sombra, porque no hay panel que separar del sitio.

     En reposo no se come el puntero: la capa cubre el documento completo y
     está ahí siempre, así que sin esto tapa el sitio entero sin verse. */
  .campo {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: block;
    pointer-events: none;

    color: var(--white);

    /* Vive dentro del <h1>: hay que devolverle una escala de lectura, y aquí
       más corta que la del panel viejo, para que quepan todas sueltas sin
       chocar unas con otras. */
    font-size: 0.8125rem;
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
    letter-spacing: normal;
    text-align: left;

    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-normal),
      visibility var(--transition-normal);
  }

  /* El manifiesto se echa atrás mientras las materias flotan por encima. Las
     dos capas son blancas sobre el azul de marca: sin este velo se pisan y no
     se lee ninguna de las dos. */
  .campo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-brand);
    opacity: 0.9;
  }

  /* `--margen` es la mitad de la palabra más ancha más lo que viaja al derivar.
     Sin él, el reparto coloca el centro y las palabras largas se salen cortadas
     por el costado: la posición marca el centro, no el borde. En la pestaña
     estrecha «memorias anuales» ocupa un tercio del ancho, así que el margen
     que necesita ahí no se parece en nada al del escritorio. */
  .materia {
    --margen: 8vw;

    position: absolute;
    left: clamp(var(--margen), var(--x), calc(100% - var(--margen)));
    top: var(--y);
    white-space: nowrap;

    /* En reposo la animación existe pero está detenida: no gasta nada mientras
       la lista no se ve. */
    animation: deriva calc(var(--dispersa-ritmo) * var(--factor)) ease-in-out
      calc(var(--dispersa-ritmo) * var(--desfase)) infinite alternate;
    animation-play-state: paused;
  }

  /* El `translate(-50%, -50%)` ancla la palabra por su centro: puesta por la
     esquina, las largas se descuelgan hacia la derecha y el reparto se tuerce. */
  @keyframes deriva {
    from {
      transform: translate(-50%, -50%) rotate(var(--giro));
    }
    to {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) rotate(var(--giro));
    }
  }

  /* El puntero ya no abre el campo: solo enseña la pista. Esparcir las materias
     por toda la pestaña al rozar la frase era un sobresalto —pasaba sin
     pedirlo y tapaba el manifiesto entero—, así que ahora hace falta el clic y
     el hover se queda en avisar de que lo hay. */
  @media (hover: hover) {
    .dispersa:hover .pista,
    .dispersa:focus-within .pista {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  /* Dado el clic, la pista sobra: ya dijo lo que tenía que decir. */
  .dispersa[data-abierto] .pista {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
  }

  /* Abierta sí se lo come, y eso es lo que sostiene el gesto: mientras las
     materias derivan sobre el velo, lo de debajo está retirado y no esperando
     el puntero. Sin esto el equipo, las marcas y el menú siguen abriendo sus
     paneles a ciegas detrás de la capa, contra una frase que ya está diciendo
     otra cosa. Lo único que queda por hacer aquí es cerrar, y de eso se ocupa
     el clic. */
  .dispersa[data-abierto] .campo {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    cursor: var(--cursor);
  }

  .dispersa[data-abierto] .materia {
    animation-play-state: running;
  }

  /* Con movimiento reducido las palabras se quedan donde cayeron. El desorden
     sigue estando: era del reparto, no del movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .materia {
      animation: none;
      transform: translate(-50%, -50%) rotate(var(--giro));
    }
  }

  /* En pantallas estrechas la pestaña es más chica y las palabras largas se
     tocan: se encogen un punto más y se apartan más del borde. Ahí sí se rozan
     algunas, y se quedan rozándose: el desorden es lo que la frase enseña, y
     una palabra medio tapada por otra sigue diciéndolo. Cortada por el filo de
     la pestaña, en cambio, solo parece rota. */
  @media (max-width: 48rem) {
    .campo {
      font-size: 0.75rem;
    }

    .materia {
      --margen: 25vw;
    }
  }
</style>

<script>
  // Un único par de escuchas para todo el documento: engancharlas por instancia
  // las acumularía en cada navegación del router de Astro.
  if (!(window as any).__dispersaMontada) {
    (window as any).__dispersaMontada = true;

    let abierta: HTMLElement | null = null;

    const cerrar = () => {
      if (!abierta) return;
      abierta.removeAttribute('data-abierto');
      abierta.querySelector('button')?.setAttribute('aria-expanded', 'false');
      abierta = null;
    };

    document.addEventListener('click', (evento) => {
      const destino = evento.target as HTMLElement;
      const raiz = destino.closest<HTMLElement>('[data-dispersa]');

      // Abierta, la capa tapa el documento entero, el propio botón incluido:
      // el clic de fuera y el que vuelve sobre la frase llegan los dos aquí, y
      // los dos piden lo mismo.
      if (!raiz || destino.closest('.campo')) return cerrar();
      if (!destino.closest('button')) return;
      if (abierta === raiz) return cerrar();

      cerrar();
      raiz.setAttribute('data-abierto', '');
      raiz.querySelector('button')?.setAttribute('aria-expanded', 'true');
      abierta = raiz;
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') cerrar();
    });

    document.addEventListener('astro:before-swap', () => {
      abierta = null;
    });
  }
</script>
