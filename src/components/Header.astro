---
// Cabecera: logotipo a la izquierda, un único botón píldora a la derecha que
// alterna entre las dos páginas del sitio. Sin menú y sin footer, según los
// mockups de agosto de 2026.
interface Props {
  /** Texto del botón. Ej. "Ver proyectos" / "Volver al inicio". */
  accion: string;
  /** Destino del botón. */
  href: string;
}

const { accion, href } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="container">
  <a href={base} class="logo" aria-label="Bastos — Inicio">
    <img src={`${base}brand/Logo-blanco.svg`} alt="" width="176" height="44" />
  </a>

  <a class="pildora" href={href}>{accion}</a>
</header>

<style>
  /* Cabecera y logotipo escalan con el ancho de pantalla, igual que los
     márgenes. Con medidas fijas el logotipo crecía en proporción al reducirse
     la pantalla y la cabecera se volvía pesada. */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-06);
    /* Menos aire abajo que arriba: acerca el contenido a la cabecera. */
    padding-block: clamp(1.5rem, 4.2vw, 5rem) clamp(1.1rem, 2.9vw, 3.4rem);
  }

  .logo img {
    height: clamp(18px, 1.78vw, 36px);
    width: auto;
  }

  /* El borde va fino a propósito: es un contorno, no un marco. */
  .pildora {
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.8em;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-pill);
    font-size: clamp(0.6875rem, 0.85vw, 1.0625rem);
    font-weight: var(--weight-regular);
    line-height: 1;
    white-space: nowrap;
    transition:
      background var(--transition-normal),
      color var(--transition-normal),
      border-color var(--transition-normal);
  }

  .pildora:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--color-brand);
    opacity: 1;
  }

  /* En pantallas táctiles la píldora se quedaba en 24px de alto: se pulsa con
     el dedo, no con un puntero. 44px es el mínimo cómodo. */
  @media (max-width: 48rem) {
    .pildora {
      min-height: 44px;
      font-size: 0.75rem;
    }
  }
</style>
