---
// Cabecera: logotipo a la izquierda, un único botón píldora a la derecha que
// alterna entre las dos páginas del sitio. Sin menú y sin footer, según los
// mockups de agosto de 2026.
interface Props {
  /** Texto del botón. Ej. "Ver proyectos" / "Volver al inicio". */
  accion: string;
  /** Destino del botón. */
  href: string;
}

const { accion, href } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="container">
  <a href={base} class="logo" aria-label="Bastos — Inicio">
    <img src={`${base}brand/Logo-blanco.svg`} alt="" width="176" height="44" />
  </a>

  <a class="pildora" href={href}>{accion}</a>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-06);
    padding-block: var(--spacing-08);
  }

  /* El logotipo de cabecera va sin el subtítulo "DISEÑO Y COMUNICACIONES":
     el SVG lo incluye, así que se recorta mostrando solo el logotipo. */
  .logo img {
    height: 38px;
    width: auto;
  }

  /* ⚠ Píldora: se aparta del sistema de diseño, que especifica botones
     rectangulares con borde de 2px. Los mockups la piden así. */
  .pildora {
    flex: none;
    padding: 0.6em 1.5em;
    border: 1.5px solid var(--white);
    border-radius: var(--radius-pill);
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    line-height: 1;
    white-space: nowrap;
    transition: background var(--transition-normal), color var(--transition-normal);
  }

  .pildora:hover {
    background: var(--white);
    color: var(--color-brand);
    opacity: 1;
  }

  @media (max-width: 40rem) {
    header {
      padding-block: var(--spacing-06);
    }

    .logo img {
      height: 28px;
    }

    .pildora {
      font-size: var(--text-body-sm);
    }
  }
</style>
