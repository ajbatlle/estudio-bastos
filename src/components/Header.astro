---
// Cabecera del sitio. Estructura y navegación tomadas del mockup aprobado
// (uploads/Web.png): logotipo a la izquierda, nav en minúscula a la derecha.
// ⚠ Provisional — los ítems de navegación quedan a la espera de la estructura final.
const base = import.meta.env.BASE_URL;

const nav = [
  { label: 'agenda', href: `${base}agenda` },
  { label: 'blog', href: `${base}blog` },
  { label: 'nosotros', href: `${base}nosotros` },
  { label: 'servicios', href: `${base}servicios` },
];

const path = Astro.url.pathname;
---

<header>
  <div class="container inner">
    <a href={base} class="logo" aria-label="Bastos — Diseño y Comunicaciones — Inicio">
      <img src={`${base}brand/Logo-blanco.svg`} alt="" width="176" height="44" />
    </a>

    <nav aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    padding-block: var(--spacing-09) var(--spacing-08);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-06);
    flex-wrap: wrap;
  }

  .logo img {
    height: 44px;
    width: auto;
  }

  nav {
    display: flex;
    gap: var(--spacing-06);
  }

  nav a {
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    color: rgb(255 255 255 / 0.82);
    transition: color var(--transition-normal);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--white);
    opacity: 1;
  }

  @media (max-width: 40rem) {
    header {
      padding-block: var(--spacing-07) var(--spacing-06);
    }

    .logo img {
      height: 34px;
    }

    nav {
      gap: var(--spacing-05);
    }

    nav a {
      font-size: var(--text-body-sm);
    }
  }
</style>
