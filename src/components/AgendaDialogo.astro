---
// Panel de agenda. Va aparte del botón que lo abre porque el botón vive dentro
// del <h1> del manifiesto, y un <dialog> ahí dentro sería HTML inválido.
//
// Se usa <dialog> nativo en vez de un div: trae gratis el atrapado del foco, el
// cierre con Escape y el fondo oscurecido. Hacerlo a mano sale peor.
//
// El envío lo hace Web3Forms: el sitio es estático y no tiene dónde procesar un
// formulario. Sin CLAVE_FORMULARIO se recurre a `mailto:`, que depende de que el
// visitante tenga programa de correo configurado y falla a menudo.
import {
  CORREO,
  CLAVE_FORMULARIO,
  HORAS,
  DIAS_REUNION,
  FECHAS_OFRECIDAS,
  ZONA,
} from '../datos/estudio';
import CorreoCopiable from './CorreoCopiable.astro';
---

<dialog class="agenda" data-agenda aria-labelledby="agenda-titulo">
  <button class="cerrar" data-agenda-cerrar aria-label="Cerrar" data-iman="0.45">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <h2 id="agenda-titulo">Agendemos una conversación</h2>
  <p class="entrada">
    Cuéntanos qué tienes en mente y propón un horario. Te confirmamos por correo.
  </p>

  <form data-agenda-form novalidate>
    <label>
      <span>Nombre</span>
      <input type="text" name="nombre" required autocomplete="name" />
    </label>

    <label>
      <span>Correo</span>
      <input type="email" name="correo" required autocomplete="email" />
    </label>

    {/* Las fechas se rellenan en el navegador, no aquí: calculadas en el build
        quedarían clavadas en el día del despliegue. */}
    <div class="par">
      <label>
        <span>Día</span>
        <select name="dia" data-agenda-dias required></select>
      </label>

      <label>
        <span>Hora</span>
        <select name="hora" required>
          {HORAS.map((h) => <option value={h}>{h}</option>)}
        </select>
      </label>
    </div>

    <p class="nota">Atendemos lunes, miércoles y viernes de 15 a 18 h.</p>

    <label>
      <span>Qué tienes en mente</span>
      <textarea name="mensaje" rows="4" required></textarea>
    </label>

    {/* Señuelo para robots: invisible y fuera del recorrido de teclado. Si
        llega relleno, el envío se descarta. */}
    <input type="checkbox" name="botcheck" class="senuelo" tabindex="-1" autocomplete="off" />

    <p class="error" data-agenda-error hidden></p>

    <button type="submit" data-agenda-enviar data-iman>Enviar propuesta</button>
  </form>

  <div class="listo" data-agenda-listo hidden>
    <p class="listo-titulo">Recibido.</p>
    <p>Te respondemos a tu correo para confirmar el horario.</p>
    <button type="button" data-agenda-cerrar data-iman>Cerrar</button>
  </div>

  <p class="alterna">
    O escríbenos directamente a <CorreoCopiable />
  </p>
</dialog>

<style>
  .agenda {
    width: min(92vw, 32rem);
    max-height: 88vh;
    overflow-y: auto;
    margin: auto;
    padding: 2.25rem;
    border: none;
    border-radius: 8px;
    background: var(--white);
    color: var(--color-brand);
    font-size: 0.9375rem;
    line-height: var(--leading-normal);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.07),
      0 8px 20px rgb(0 0 0 / 0.14),
      0 32px 64px rgb(0 0 0 / 0.18);

    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  .agenda[open] {
    opacity: 1;
    transform: none;
  }

  /* Estado de partida de la animación de entrada. Sin esto el panel aparece
     de golpe: un elemento que pasa de display:none no transiciona. */
  @starting-style {
    .agenda[open] {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .agenda::backdrop {
    background: rgb(0 8 40 / 0);
    transition:
      background var(--transition-normal),
      overlay var(--transition-normal) allow-discrete,
      display var(--transition-normal) allow-discrete;
  }

  .agenda[open]::backdrop {
    background: rgb(0 8 40 / 0.55);
  }

  @starting-style {
    .agenda[open]::backdrop {
      background: rgb(0 8 40 / 0);
    }
  }

  h2 {
    font-size: 1.375rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    padding-right: 2rem;
  }

  .entrada {
    margin-top: 0.6rem;
    color: rgb(0 0 0 / 0.6);
    font-size: 0.875rem;
  }

  .cerrar {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-brand);
    cursor: var(--cursor);
    opacity: 0.5;
    transition: opacity var(--transition-normal), background var(--transition-normal);
  }

  .cerrar:hover {
    opacity: 1;
    background: rgb(0 0 0 / 0.05);
  }

  .cerrar svg {
    width: 17px;
    height: 17px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .par {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* En caja baja como el resto del sitio. El tracking ancho se va con las
     versales: separar las letras de una palabra en minúscula solo la afea. */
  label span {
    font-size: 0.8rem;
    color: rgb(0 0 0 / 0.55);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.6rem 0.7rem;
    border: 1px solid rgb(0 0 0 / 0.16);
    border-radius: 4px;
    background: var(--white);
    color: var(--color-brand);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    transition: border-color var(--transition-normal);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-brand);
  }

  form button[type='submit'] {
    margin-top: 0.5rem;
    padding: 0.8em 1.6em;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--white);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: var(--tracking-wide);
    cursor: var(--cursor);
    transition: opacity var(--transition-normal);
  }

  form button[type='submit']:hover {
    opacity: 0.85;
  }

  form button[type='submit']:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .senuelo {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .nota {
    margin-top: -0.35rem;
    font-size: 0.75rem;
    color: rgb(0 0 0 / 0.45);
  }

  .error {
    color: #b0132a;
    font-size: 0.8125rem;
  }

  .listo {
    margin-top: 1.75rem;
  }

  .listo-titulo {
    font-size: 1.125rem;
    font-weight: var(--weight-bold);
    margin-bottom: 0.35rem;
  }

  .listo button {
    margin-top: 1.25rem;
    padding: 0.7em 1.5em;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-brand);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    cursor: var(--cursor);
    transition: background var(--transition-normal);
  }

  .listo button:hover {
    background: rgb(0 0 0 / 0.05);
  }

  [hidden] {
    display: none;
  }

  .alterna {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    font-size: 0.8125rem;
    color: rgb(0 0 0 / 0.6);
  }

  .alterna :global(.correo) {
    color: var(--color-brand);
  }

  @media (max-width: 30rem) {
    .agenda {
      padding: 1.75rem 1.25rem;
    }

    .par {
      grid-template-columns: 1fr;
    }
  }

  /* La equis de cerrar es el control más pequeño del panel y en táctil hay que
     acertarle con el dedo, en una esquina. */
  @media (max-width: 48rem) {
    .cerrar {
      width: 44px;
      height: 44px;
      top: 0.9rem;
      right: 0.9rem;
    }
  }
</style>

<script
  define:vars={{
    CORREO,
    CLAVE: CLAVE_FORMULARIO,
    DIAS: DIAS_REUNION,
    FECHAS: FECHAS_OFRECIDAS,
    ZONA,
  }}
>
  if (!window.__agendaMontada) {
    window.__agendaMontada = true;

    // Las próximas fechas en que el estudio atiende. Se calculan aquí y no en
    // el build por lo mismo que el reloj: al desplegar quedarían congeladas.
    const fechasValidas = () => {
      // El día de hoy según el reloj de Chile, no el del visitante: la agenda
      // es la del estudio, y en Tokio ya puede ser mañana.
      const hoyCL = new Intl.DateTimeFormat('en-CA', { timeZone: ZONA }).format(new Date());
      const [anio, mes, dia] = hoyCL.split('-').map(Number);

      // Se avanza en UTC para que los cambios de horario de verano no muevan
      // el día al sumar jornadas.
      const cursor = new Date(Date.UTC(anio, mes - 1, dia));
      const etiqueta = new Intl.DateTimeFormat('es-CL', {
        timeZone: 'UTC',
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      });

      const salida = [];
      // Desde mañana: una reunión hoy a las 15 no sirve si ya son las 17.
      while (salida.length < FECHAS) {
        cursor.setUTCDate(cursor.getUTCDate() + 1);
        if (DIAS.includes(cursor.getUTCDay())) {
          salida.push({
            valor: cursor.toISOString().slice(0, 10),
            texto: etiqueta.format(cursor),
          });
        }
      }
      return salida;
    };

    const enganchar = () => {
      const panel = document.querySelector('[data-agenda]');
      const form = document.querySelector('[data-agenda-form]');
      if (!panel || !form) return;

      const error = panel.querySelector('[data-agenda-error]');

      const listaDias = panel.querySelector('[data-agenda-dias]');
      if (listaDias && !listaDias.options.length) {
        for (const f of fechasValidas()) {
          const opcion = document.createElement('option');
          opcion.value = f.valor;
          opcion.textContent = f.texto;
          listaDias.append(opcion);
        }
      }

      document.querySelectorAll('[data-agenda-abrir]').forEach((boton) => {
        boton.addEventListener('click', () => panel.showModal());
      });

      panel.querySelectorAll('[data-agenda-cerrar]').forEach((b) => {
        b.addEventListener('click', () => panel.close());
      });

      // Clic en el fondo oscurecido: el <dialog> recibe el evento cuando el
      // punto pulsado cae fuera de su caja.
      panel.addEventListener('click', (evento) => {
        const c = panel.getBoundingClientRect();
        const fuera =
          evento.clientX < c.left ||
          evento.clientX > c.right ||
          evento.clientY < c.top ||
          evento.clientY > c.bottom;
        if (fuera) panel.close();
      });

      const mostrarError = (texto) => {
        error.textContent = texto;
        error.hidden = false;
      };

      form.addEventListener('input', () => {
        error.hidden = true;
      });

      const boton = form.querySelector('[data-agenda-enviar]');
      const listo = panel.querySelector('[data-agenda-listo]');
      const etiquetaBoton = boton.textContent;

      form.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        const datos = Object.fromEntries(new FormData(form));

        if (datos.botcheck) return; // Señuelo relleno: es un robot.

        if (!datos.nombre?.trim()) return mostrarError('Falta tu nombre.');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(datos.correo ?? ''))
          return mostrarError('Revisa el correo: no parece una dirección válida.');
        if (!datos.dia) return mostrarError('Elige un día.');
        if (!datos.mensaje?.trim()) return mostrarError('Cuéntanos brevemente qué tienes en mente.');

        const cuerpo = [
          `Nombre: ${datos.nombre}`,
          `Correo: ${datos.correo}`,
          `Horario propuesto: ${datos.dia} a las ${datos.hora}`,
          '',
          datos.mensaje,
        ].join('\n');

        // Sin clave no hay quien envíe: se recurre al programa de correo del
        // visitante, que es justo lo que la clave viene a resolver.
        if (!CLAVE) {
          window.location.href =
            `mailto:${CORREO}` +
            `?subject=${encodeURIComponent(`Reunión con ${datos.nombre}`)}` +
            `&body=${encodeURIComponent(cuerpo)}`;
          return;
        }

        boton.disabled = true;
        boton.textContent = 'Enviando…';

        try {
          const respuesta = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: CLAVE,
              subject: `Reunión con ${datos.nombre}`,
              from_name: 'Web de Estudio Bastos',
              replyto: datos.correo,
              nombre: datos.nombre,
              correo: datos.correo,
              horario: `${datos.dia} a las ${datos.hora}`,
              mensaje: datos.mensaje,
            }),
          });

          const resultado = await respuesta.json();
          if (!resultado.success) throw new Error(resultado.message ?? 'Envío rechazado');

          form.hidden = true;
          listo.hidden = false;
        } catch {
          mostrarError(
            `No pudimos enviarlo. Escríbenos a ${CORREO} y lo vemos.`,
          );
          boton.disabled = false;
          boton.textContent = etiquetaBoton;
        }
      });
    };

    document.addEventListener('astro:page-load', enganchar);
  }
</script>
