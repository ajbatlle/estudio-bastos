---
// Pie con la fecha y la hora de Chile.
//
// Todo se resuelve en el navegador: el sitio es estático, así que un valor
// calculado en el build quedaría clavado en la fecha del despliegue. Se deja
// vacío en el HTML y se rellena al cargar; si no hubiera JavaScript, el pie
// aparece sin texto, que es preferible a mostrar una fecha falsa.
import { ZONA } from '../datos/estudio';
import { idioma, otraVersion } from '../i18n';

const en = idioma(Astro.url) === 'en';
const otra = otraVersion(Astro.url);
---

<footer class="container">
  <p class="fecha" data-reloj-fecha></p>
  <p class="hora">
    <span data-reloj-hora></span>
    <span class="zona">{en ? 'santiago, chile' : 'santiago de chile'}</span>
    {/* El cambio de idioma va aquí, junto a la ciudad: es lo último que se mira
        en la página y no compite con nada. Lleva el nombre del otro idioma en
        ese idioma, para que quien no lee el actual lo reconozca. */}
    <a class="idioma" href={otra.href} lang={otra.lang} hreflang={otra.lang}>
      {otra.lang === 'en' ? 'english' : 'español'}
    </a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-05);
    flex-wrap: wrap;
    padding-block: clamp(1.25rem, 2.4vw, 2.25rem);
    font-size: clamp(0.6875rem, 0.75vw, 0.875rem);
    color: rgb(255 255 255 / 0.55);
  }

  /* La altura mínima reserva el sitio del texto antes de que el script lo
     escriba, para que el pie no dé un salto al cargar. */
  .fecha,
  .hora {
    min-height: 1em;
  }

  .hora {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }

  /* Cifras de ancho fijo: sin esto el reloj se mueve cada vez que cambia un
     dígito, porque no todos ocupan lo mismo. */
  [data-reloj-hora] {
    font-variant-numeric: tabular-nums;
  }

  .zona {
    color: rgb(255 255 255 / 0.38);
  }

  /* Casi invisible en reposo, igual que la ciudad; se enciende al pasar. */
  .idioma {
    color: rgb(255 255 255 / 0.38);
    transition: color var(--transition-normal);
  }

  .idioma::before {
    content: '·';
    margin-right: 0.6em;
  }

  .idioma:hover,
  .idioma:focus-visible {
    color: rgb(255 255 255 / 0.9);
    opacity: 1;
  }
</style>

<script define:vars={{ zona: ZONA }}>
  if (!window.__relojMontado) {
    window.__relojMontado = true;

    // El idioma se lee en cada tic y no al montar: este guion se carga una
    // sola vez, y al pasar de /proyectos a /en/proyectos sigue vivo.
    const formatos = {};
    const formatosDe = (lang) => {
      const locale = lang === 'en' ? 'en-GB' : 'es-CL';
      return (formatos[lang] ??= {
        fecha: new Intl.DateTimeFormat(locale, {
          timeZone: zona,
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }),
        hora: new Intl.DateTimeFormat(locale, {
          timeZone: zona,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        }),
      });
    };

    let tic;

    const arrancar = () => {
      const fecha = document.querySelector('[data-reloj-fecha]');
      const hora = document.querySelector('[data-reloj-hora]');
      if (!fecha || !hora) return;

      const pintar = () => {
        const ahora = new Date();
        const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
        const f = formatosDe(lang);
        // es-CL ya devuelve el día y el mes en minúscula; en-GB no.
        const texto = f.fecha.format(ahora);
        fecha.textContent = lang === 'en' ? texto.toLowerCase() : texto;
        hora.textContent = f.hora.format(ahora);
      };

      pintar();
      clearInterval(tic);
      tic = setInterval(pintar, 1000);
    };

    // Al navegar entre páginas se descarta el pie viejo: hay que parar el
    // intervalo y volver a engancharlo al nuevo.
    document.addEventListener('astro:page-load', arrancar);
    document.addEventListener('astro:before-swap', () => clearInterval(tic));
  }
</script>
