---
// Sonido del estudio. No pinta nada: solo escucha los clics de la marca de
// rombos —`control="sonido"`— y enciende o apaga la pista.
//
// El <audio> no vive en el DOM a propósito. Astro reemplaza el <body> al
// navegar sin recarga, así que un elemento en la página cortaría la música al
// cambiar de sección. Colgado de `window` sobrevive a la navegación, que es lo
// que se espera de algo que suena de fondo.
---

<script>
  if (!(window as any).__sonidoMontado) {
    (window as any).__sonidoMontado = true;

    const PISTA = `${import.meta.env.BASE_URL}media/start-of-the-journey.mp3`;

    const rotular = () => {
      const audio = (window as any).__sonido as HTMLAudioElement | undefined;
      const sonando = !!audio && !audio.paused;

      document.querySelectorAll<HTMLElement>('[data-control="sonido"]').forEach((mando) => {
        mando.toggleAttribute('data-sonando', sonando);
        mando.setAttribute(
          'aria-label',
          sonando ? 'Sonido: sonando. Pulsa para detener.' : 'Sonido: en silencio. Pulsa para oír.',
        );
      });
    };

    // Se crea al primer clic y no antes: así los 6 MB de la pista no se
    // descargan a nadie que no la haya pedido.
    const pista = () => {
      if (!(window as any).__sonido) {
        const audio = new Audio(PISTA);
        audio.loop = true;
        audio.preload = 'none';
        audio.addEventListener('play', rotular);
        audio.addEventListener('pause', rotular);
        (window as any).__sonido = audio;
      }
      return (window as any).__sonido as HTMLAudioElement;
    };

    document.addEventListener('click', (evento) => {
      const mando = (evento.target as HTMLElement).closest('[data-control="sonido"]');
      if (!mando) return;

      const audio = pista();
      // El navegador puede negarse a reproducir; si pasa, el estado se queda
      // como estaba en vez de mentir en la etiqueta.
      if (audio.paused) audio.play().catch(rotular);
      else audio.pause();
    });

    document.addEventListener('astro:page-load', rotular);
  }
</script>
