---
// Cómo se lee un afiche. El afiche no lleva leyenda para no llenarse de texto;
// la explicación vive aquí, en la página a la que lleva su QR.
//
// Cada muestra se dibuja sobre un trozo de pantalla azul, porque los discos y
// las líneas son hueso y sobre el mesh no se distinguirían. Y cada una lleva
// su frase: ningún significado depende solo del color.
const HUESO = '#F2EDE0', ROJA = '#D0452B', NEGRA = '#1B1B1B', AZUL = '#003EC0';

const disco = (fondo: string, borde: string | null, n: string, tinta: string, anillo = false) =>
  `<circle cx="20" cy="12" r="8" fill="${fondo}"${borde ? ` stroke="${borde}" stroke-width="1.4"` : ''}/>` +
  (anillo ? `<circle cx="20" cy="12" r="11" fill="none" stroke="${HUESO}"/>` : '') +
  `<text x="20" y="15" font-size="8.5" font-weight="700" text-anchor="middle" fill="${tinta}">${n}</text>`;

const muestras = [
  [disco(HUESO, null, '8', AZUL), 'Tocó la pelota en la jugada, con su dorsal.'],
  [disco(ROJA, HUESO, '10', HUESO), 'Messi.'],
  [disco('none', HUESO, '9', HUESO), 'Un compañero que estaba en la cancha en el momento del remate.'],
  [disco(NEGRA, HUESO, '4', HUESO) , 'Un rival.'],
  [disco(NEGRA, HUESO, '1', HUESO, true), 'El arquero rival.'],
  [`<line x1="4" y1="12" x2="36" y2="12" stroke="${HUESO}" stroke-width="1.6"/>`, 'Un pase.'],
  [`<line x1="4" y1="12" x2="36" y2="12" stroke="${HUESO}" stroke-width="1.2" stroke-dasharray="2 4"/>`, 'La pelota llevada por un jugador.'],
  [`<line x1="4" y1="12" x2="36" y2="12" stroke="${HUESO}" stroke-width="2.5" stroke-dasharray="7 4"/>`, 'Un remate anterior, atajado o desviado.'],
  [`<line x1="4" y1="12" x2="30" y2="12" stroke="${ROJA}" stroke-width="3.5"/><path d="M36 12 L28 8.4 L28 15.6 Z" fill="${ROJA}"/>`, 'El remate que entró.'],
];
---

<section class="leyenda" aria-labelledby="leyenda-titulo">
  <h2 id="leyenda-titulo">Cómo se lee</h2>
  <ul>
    {muestras.map(([svg, texto]) => (
      <li>
        <svg viewBox="0 0 40 24" width="40" height="24" aria-hidden="true">
          <rect width="40" height="24" fill={AZUL} />
          <Fragment set:html={svg} />
        </svg>
        <span>{texto}</span>
      </li>
    ))}
  </ul>
  <p>
    El marcador dice cómo iba el partido justo después del gol. Un triángulo
    bajo la pantalla avisa que la jugada viene de más atrás de lo que se ve.
  </p>
</section>

<style>
  .leyenda {
    font-size: var(--text-body-sm);
  }

  h2 {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    margin-bottom: 0.6rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  svg {
    flex: none;
    font-family: var(--font-sans);
  }

  p {
    margin-top: 0.8rem;
    max-width: 34em;
    opacity: 0.85;
  }
</style>
